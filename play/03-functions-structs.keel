// ============================================================
//  Keel — туториал
//  Часть 3. Функции и структуры
// ============================================================
//
//      ./target/debug/keelc run play/03-functions-structs.keel
//
// ============================================================


// ------------------------------------------------------------
// 3.1. Функции
// ------------------------------------------------------------
//
//     fn имя(параметры) ТИП_ВОЗВРАТА { тело }
//
// Тип возврата пишется ПОСЛЕ скобок. Если функция ничего не
// возвращает, тип не пишется вовсе (это не `void`).

fn greet(name string) {
    println("Привет, ", name, "!");
}

fn add(a int, b int) int {
    return a + b;
}

// Возврат может быть в любом месте — ранний выход:
fn max_of(a int, b int) int {
    if a > b {
        return a;
    }
    return b;
}

// `return;` без значения — это «выйти сейчас», он допустим
// только там, где функция ничего не возвращает:
//
//     fn log(x int) {          // тип возврата не указан
//         if x < 0 {
//             return;          // ок: выходим из функции
//         }
//         println(x);
//     }
//
// В функции с типом возврата `return;` — ошибка:
//
//     fn f() int {
//         return;              // ошибка: функция возвращает `int`,
//     }                        // поэтому `return` требует значение
//
// Исключение — `main`: там `return;` означает «выход с кодом 0»,
// как в C. Поэтому `fn main() int { ... return; }` законно.
// Если функция с типом возврата заканчивается без `return` на
// каком-то пути, компилятор подставит нулевое значение — поведение
// будет определено, но лучше так не писать.

// Рекурсия работает как обычно:
fn factorial(n int) int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

// Ранний выход через `return;` в функции без возврата:
fn print_positive(x int) {
    if x <= 0 {
        println("не положительное");
        return;
    }
    println("положительное: ", x);
}

fn functions() {
    greet("мир");
    println("2 + 3 = ", add(2, 3));
    println("max(7, 4) = ", max_of(7, 4));
    println("5! = ", factorial(5));
    print_positive(5);
    print_positive(-1);
}

// ------------------------------------------------------------
// 3.2. Структуры
// ------------------------------------------------------------
//
//     struct Имя { поле тип; ... }
//
// Типы полей — тоже после имени, без двоеточия.
//
// Конструктор создаётся автоматически и называется как тип:
// `User("John", 26)` — поля в порядке объявления.

struct User {
    name string;
    age int;
}

// Структуры можно вкладывать:
struct Point {
    x int;
    y int;
}

struct Line {
    from Point;
    to Point;
}

fn structs() {
    let u User = User("John", 26);
    println(u.name, " ", u.age);

    // Доступ к полям — через точку.
    let p Point = Point(1, 2);
    println("точка: ", p.x, ",", p.y);

    // Вложенные структуры:
    let l Line = Line(Point(0, 0), Point(3, 4));
    println("линия: ", l.from.x, ",", l.from.y, " -> ", l.to.x, ",", l.to.y);
}

// ------------------------------------------------------------
// 3.3. Массивы
// ------------------------------------------------------------
//
//     let имя [ТИП; РАЗМЕР] = [значения...];
//
// Размер — ЧАСТЬ ТИПА. Массив фиксированной длины, как в C.
// Растущего списка (Vec) пока нет — это волна 8 плана.

fn arrays() {
    let nums [int; 4] = [10, 20, 30, 40];
    println("элемент 0: ", nums[0]);
    println("элемент 3: ", nums[3]);

    // Размер не надо помнить: его считает `len`.
    println("длина: ", len(nums));

    // Индекс может быть переменной и выражением:
    let i int = 1;
    println("nums[i] = ", nums[i]);
    println("nums[i + 1] = ", nums[i + 1]);

    // Массивы бывают любых типов, включая строки, bool и структуры:
    let names [string; 2] = ["John", "Mary"];
    let flags [bool; 2] = [true, false];
    let users [User; 2] = [User("John", 26), User("Mary", 18)];
    println(names[1], " ", flags[0], " ", users[0].name);

    // Вложенные массивы:
    let grid [[int; 2]; 2] = [[1, 2], [3, 4]];
    println("grid[1][0] = ", grid[1][0]);
}

// ------------------------------------------------------------
// 3.4. Методы
// ------------------------------------------------------------
//
// Методы объявляются в блоке `impl Имя { ... }`.
//
// Первый параметр называется `self` и описывает, как метод
// получает объект:
//
//     self &T          ссылка — объект остаётся у вызывающего
//     self T           перемещение — метод забирает объект насовсем
//
// По умолчанию пишите `self &T`. Компилятор сам подскажет, если
// нужен `self T` — в месте, где объект кладут в поле.
//
// ТРИ ПРАВИЛА, КОТОРЫЕ НАДО ЗАПОМНИТЬ:
//
//   1. `self` ОБЯЗАТЕЛЕН, если функция должна быть методом.
//      Функция в `impl` без `self` — не метод, а ассоциированная
//      функция (см. 3.6): вызывается через `Имя::функция()`,
//      а не через точку.
//
//   2. Тип у `self` ОБЯЗАТЕЛЕН. В Rust пишут просто `&self`, но
//      в Keel это не работает: надо `self &User`. Тип нужен, чтобы
//      компилятор знал, чей это метод, и проверял поля.
//      `fn get_name(self) string` — ошибка разбора.
//
//   3. `self` ОБЯЗАН быть ПЕРВЫМ. `fn greet(other string, self &User)`
//      компилируется как обычная функция, но методом не считается:
//      вызов `u.greet("Боря")` даст «у типа `User` нет метода `greet`».
//
// Всё это — как в Rust, кроме пункта 2: там тип у `self` пишется
// отдельно (`&self`), здесь он входит в сам параметр.

impl User {
    fn get_name(self &User) string {
        return self.name;
    }

    fn is_adult(self &User) bool {
        return self.age >= 18;
    }
}

fn methods() {
    let u User = User("John", 26);

    // Вызов метода — через точку. Ссылку компилятор берёт сам:
    // `u.get_name()` — это `User::get_name(&u)`.
    println("имя: ", u.get_name());
    println("совершеннолетний: ", u.is_adult());
}

// ------------------------------------------------------------
// 3.5. Методы, изменяющие объект
// ------------------------------------------------------------
//
// Если метод меняет объект, это видно в его подписи — контракт
// `mut(self)`. Вызывающий обязан объявить переменную как `mut`.
//
// Это главное отличие от C++: по вызову `p.inc()` невозможно
// понять, меняется ли объект. В Keel видно и в объявлении, и
// в объявлении переменной.

struct Counter {
    value int;
}

impl Counter {
    fn get(self &Counter) int {
        return self.value;
    }

    // `mut(self)` — контракт: метод изменяет объект.
    fn inc(self &Counter) mut(self) {
        self.value = self.value + 1;
    }

    fn add(self &Counter, n int) mut(self) {
        self.value = self.value + n;
    }
}

fn mutating_methods() {
    // `let mut` обязателен: метод изменяет объект.
    let mut c Counter = Counter(0);

    c.inc();
    c.inc();
    c.add(10);

    println("значение: ", c.get());
}

// ------------------------------------------------------------
// 3.6. Ассоциированные функции
// ------------------------------------------------------------
//
// В `impl` можно объявить функцию БЕЗ `self` — тогда она
// вызывается через `Тип::имя(...)`, а не через объект.
//
// Это принятый в языке способ делать конструкторы с логикой.
//
// ЧТО ТАКОЕ `::` ЗДЕСЬ
//
// `::` — это доступ к функции, объявленной в `impl` типа. Как
// статический метод в Java (`Point.origin()`), только синтаксис
// другой. Внутри компилятора `::` — просто склейка двух имён в
// одно (`Point` + `origin` → `Point::origin`), а потом поиск
// функции с таким именем. Отсюда следствия:
//
//   * `::` работает ТОЛЬКО в выражениях: `Point::origin()`.
//     В типе (`let p Point::Point`) — ошибка разбора.
//   * слева ДОЛЖНО быть имя типа. `p::make()` (переменная слева)
//     не работает — это не «вызов на объекте», для этого есть точка.
//   * `::` не «статический контекст»: у Keel нет статических полей
//     и нет `static`. Это просто способ назвать функцию типа.
//   * у встроенных типов ассоциированных функций нет:
//     `int::max(1, 2)` — «неизвестная функция».
//
// Сравнение с другими языками:
//
//     Java     Point.origin()      — статический метод класса
//     Rust     Point::origin()     — ассоциированная функция
//     Keel     Point::origin()     — то же, что в Rust
//
// Отличие от Java: в Java статический метод — часть класса, и у
// класса есть статические поля. В Keel `impl` — это просто набор
// функций, привязанных к типу; никакого «классового состояния» нет.

impl Point {
    fn origin() Point {
        return Point(0, 0);
    }

    fn scaled(self &Point, k int) Point {
        return Point(self.x * k, self.y * k);
    }
}

fn assoc_functions() {
    // Вызов без объекта — через `::`
    let o Point = Point::origin();
    println("начало координат: ", o.x, ",", o.y);

    // И можно сразу вызвать метод на результате:
    let p Point = Point(2, 3);
    let s Point = p.scaled(10);
    println("увеличенная: ", s.x, ",", s.y);
}

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 3.1. Функции ===");
    functions();
    println();

    println("=== 3.2. Структуры ===");
    structs();
    println();

    println("=== 3.3. Массивы ===");
    arrays();
    println();

    println("=== 3.4. Методы ===");
    methods();
    println();

    println("=== 3.5. Методы, изменяющие объект ===");
    mutating_methods();
    println();

    println("=== 3.6. Ассоциированные функции ===");
    assoc_functions();

    return 0;
}
