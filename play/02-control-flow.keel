// ============================================================
//  Keel — туториал
//  Часть 2. Управление потоком: условия и циклы
// ============================================================
//
//      ./target/debug/keelc run play/02-control-flow.keel
//
// ============================================================


// ------------------------------------------------------------
// 2.1. if / else
// ------------------------------------------------------------
//
// Скобки вокруг условия ОБЯЗАТЕЛЬНЫ — как в C, в отличие от Rust
// и Go, где их нет.

fn conditions() {
    let age int = 20;

    if age >= 18 {
        println("совершеннолетний");
    } else {
        println("несовершеннолетний");
    }

    // `else if` — как в C, а не `elif` как в Python.
    let score int = 75;
    if score >= 90 {
        println("отлично");
    } else if score >= 70 {
        println("хорошо");
    } else if score >= 50 {
        println("удовлетворительно");
    } else {
        println("плохо");
    }
}

// ------------------------------------------------------------
// 2.2. Логические операторы
// ------------------------------------------------------------
//
//     &&   и
//     ||   или
//     !    не
//
// Операторы короткого замыкания: если левая часть `&&` ложна,
// правая не вычисляется.

fn logic() {
    let a bool = true;
    let b bool = false;

    println("true && false = ", a && b);    // false
    println("true || false = ", a || b);    // true
    println("!true = ", !a);                // false

    // Сравнения дают bool:
    let n int = 5;
    if n > 0 && n < 10 {
        println("n между 0 и 10");
    }
}

// ------------------------------------------------------------
// 2.3. if как выражение
// ------------------------------------------------------------
//
// `if` может быть значением: обе ветки дают значение одного типа.
// Это заменяет тернарный оператор `? :` из C — отдельного `?:`
// в языке нет.

fn if_expression() {
    let n int = 7;

    // Вместо `let s = n % 2 == 0 ? "чёт" : "нечет";`
    let parity string = if n % 2 == 0 { "чётное" } else { "нечётное" };
    println(n, " — ", parity);

    // Работает и в аргументе:
    println("знак: ", if n > 0 { "плюс" } else { "минус" });
}

// ------------------------------------------------------------
// 2.4. while
// ------------------------------------------------------------
//
// Условие проверяется ПЕРЕД телом: если оно ложно сразу, тело
// не выполнится ни разу.

fn while_loop() {
    let mut i int = 0;
    while i < 3 {
        println("while: ", i);
        i += 1;
    }
}

// ------------------------------------------------------------
// 2.5. do-while
// ------------------------------------------------------------
//
// Тело выполняется ХОТЯ БЫ РАЗ, условие проверяется в конце.
// В Rust такого цикла нет; в C он есть — и здесь тоже.

fn do_while_loop() {
    let mut i int = 10;

    // Условие `i < 3` ложно сразу, но тело выполнится один раз.
    do {
        println("do-while выполнилось, i = ", i);
        i += 1;
    } while i < 3;
}

// ------------------------------------------------------------
// 2.6. for по диапазону
// ------------------------------------------------------------
//
// `for i in НАЧАЛО..КОНЕЦ` — правая граница НЕ включается,
// как в Rust и Python.
//
//     for i in 0..3     даёт 0, 1, 2

fn for_range() {
    for i in 0..3 {
        println("диапазон: ", i);
    }

    // Границы могут быть переменными:
    let n int = 2;
    for i in 0..n {
        println("до переменной: ", i);
    }
}

// ------------------------------------------------------------
// 2.7. for по массиву
// ------------------------------------------------------------
//
// `for элемент in массив` — перебирает ЗНАЧЕНИЯ, а не индексы.
// Это отличается от C, где всегда индекс.

fn for_array() {
    let names = ["John", "Mary", "James"];

    for name in names {
        println("имя: ", name);
    }

    // Если нужен индекс — используйте диапазон и `len`:
    for i in 0..len(names) {
        println(i, ": ", names[i]);
    }
}

// ------------------------------------------------------------
// 2.8. break и continue
// ------------------------------------------------------------
//
//     break      выйти из цикла
//     continue   перейти к следующей итерации
//
// Работают во всех четырёх видах циклов: while, do-while,
// for по диапазону, for по массиву.

fn break_continue() {
    // break — остановиться, когда нашли нужное.
    for i in 0..10 {
        if i == 3 {
            println("остановились на ", i);
            break;
        }
    }

    // continue — пропустить ненужное.
    for i in 0..5 {
        if i % 2 == 0 {
            continue;              // пропускаем чётные
        }
        println("нечётное: ", i);
    }
}

// ------------------------------------------------------------
// 2.9. Вложенные циклы
// ------------------------------------------------------------
//
// `break` выходит только из СВОЕГО цикла — внутреннего.
// Чтобы выйти из обоих, нужен флаг (меток в языке нет).

fn nested() {
    for i in 0..3 {
        for j in 0..3 {
            if j == 2 {
                break;             // выходим только из внутреннего
            }
            print(i, ":", j, " ");
        }
        println();
    }
}

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 2.1. if / else ===");
    conditions();
    println();

    println("=== 2.2. Логика ===");
    logic();
    println();

    println("=== 2.3. if как выражение ===");
    if_expression();
    println();

    println("=== 2.4. while ===");
    while_loop();
    println();

    println("=== 2.5. do-while ===");
    do_while_loop();
    println();

    println("=== 2.6. for по диапазону ===");
    for_range();
    println();

    println("=== 2.7. for по массиву ===");
    for_array();
    println();

    println("=== 2.8. break и continue ===");
    break_continue();
    println();

    println("=== 2.9. Вложенные циклы ===");
    nested();

    return 0;
}
