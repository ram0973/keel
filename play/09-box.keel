// ============================================================
//  Keel — туториал
//  Часть 9. Box: значение в куче
// ============================================================
//
//      ./target/debug/keelc run play/09-box.keel
//
//  `Vec<T>` — массив в куче. `Box<T>` — ОДНО значение в куче, у
//  которого единственный владелец.
//
//      let b Box<Node> = Box::new(Node { value: 10 });
//
//  Зачем это нужно: без `Box` структура не может содержать саму
//  себя — размер получился бы бесконечным:
//
//      struct Node { value int; next Node; }        // ошибка E018
//      struct Node { value int; next Box<Node>; }   // законно
//
//  Именно так делается связный список: узлы стоят в куче, а связи
//  между ними — настоящие указатели, а не индексы арены.
// ============================================================


// ------------------------------------------------------------
//  9.1. Box и разыменование
// ------------------------------------------------------------
//
//  Разыменование автоматическое, как у ссылок: отдельного `*` в
//  языке нет. `b.value` — как `b.value` у обычной структуры.

struct Point {
    x int;
    y int;
}

fn box_basics() {
    let b Box<Point> = Box::new(Point { x: 3, y: 4 });
    println("координаты: ", b.x, ", ", b.y);
}


// ------------------------------------------------------------
//  9.2. Владение единственное
// ------------------------------------------------------------
//
//  `Box` копировать нельзя — он перемещается, как `Vec`:
//  после `let c = b;` переменная `b` больше не годится.

fn box_move() {
    let b Box<Point> = Box::new(Point { x: 1, y: 2 });
    let c Box<Point> = b;
    // `println(b.x);` — ошибка: `b` уже перемещён.
    println("после перемещения: ", c.x, ", ", c.y);
}


// ------------------------------------------------------------
//  9.3. Пустого Box не бывает
// ------------------------------------------------------------
//
//  В Keel нет `null`, поэтому «значения нет» выражается через
//  `Option<Box<T>>` — как и для любого другого значения.

struct Node {
    value int;
    next Option<Box<Node>>;
}

fn empty_box() {
    let nothing Option<Box<Node>> = None;
    match nothing {
        Some(node) => { println("узел: ", node.value); }
        None => { println("узла нет"); }
    }
}


// ------------------------------------------------------------
//  9.4. Связный список
// ------------------------------------------------------------
//
//  Каждый узел владеет следующим. Список собирается с конца:
//  новый узел становится головой и забирает старый в `next`.
//
//  Освобождение — автоматическое: когда список больше не нужен,
//  узлы освобождаются один за другим, от головы к хвосту.

fn sum(n &Option<Box<Node>>) int {
    match n {
        Some(node) => {
            return node.value + sum(&node.next);
        }
        None => {
            return 0;
        }
    }
}

fn show(n &Option<Box<Node>>) {
    match n {
        Some(node) => {
            print(node.value, " ");
            show(&node.next);
        }
        None => {
            return;
        }
    }
}

fn linked_list() {
    let mut head Option<Box<Node>> = None;

    head = Some(Box::new(Node { value: 30, next: head }));
    head = Some(Box::new(Node { value: 20, next: head }));
    head = Some(Box::new(Node { value: 10, next: head }));

    print("список: ");
    show(&head);
    println();
    println("сумма:  ", sum(&head));
}


// ------------------------------------------------------------
//  9.5. Чего Box не умеет
// ------------------------------------------------------------
//
//  Циклы. Двусвязный список (`prev` и `next` указывают друг на
//  друга) образовал бы цикл, и автоматическое освобождение
//  освободило бы один блок дважды. Для циклических структур нужен
//  либо индексный доступ (арена `Vec`), либо ручное управление —
//  и то и другое в Keel пока нет.

fn main() int {
    println("=== 9.1. Box ===");
    box_basics();
    println();

    println("=== 9.2. Перемещение ===");
    box_move();
    println();

    println("=== 9.3. Пустого Box не бывает ===");
    empty_box();
    println();

    println("=== 9.4. Связный список ===");
    linked_list();

    return 0;
}
