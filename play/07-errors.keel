// ============================================================
//  Keel — туториал
//  Часть 7. Ошибки компилятора и что они значат
// ============================================================
//
//      ./target/debug/keelc run play/07-errors.keel
//
//  Этот файл КОМПИЛИРУЕТСЯ — все ошибки здесь закомментированы.
//  Запустите его, чтобы увидеть, как выглядит правильный код,
//  а рядом прочитайте, что скажет компилятор на неправильный.
//
//  Компилятор Keel проверяет владение ДО запуска. Ошибка — это
//  не «программа упала», а «программа не собралась». Ошибку
//  невозможно увидеть в рантайме, потому что до рантайма дело
//  не дойдёт.
// ============================================================


struct User {
    name string;
    age int;
}

// ------------------------------------------------------------
// 7.1. Забыли `let`
// ------------------------------------------------------------
//
//     fn main() int {
//         x int = 5;              // ← нет let
//         return 0;
//     }
//
// Компилятор:
//     ошибка: строка 2: похоже, пропущено `let`: напишите `let x ...`
//             — объявление переменной начинается с `let`
//
// Это самая частая ошибка новичка. Keel не угадывает: объявление
// всегда начинается с `let`.

fn forgot_let() {
    let x int = 5;
    println("правильно: let x int = ", x);
}

// ------------------------------------------------------------
// 7.2. Изменение без `mut`
// ------------------------------------------------------------
//
//     fn main() int {
//         let n int = 1;
//         n = 2;                  // ← n не mut
//         return 0;
//     }
//
// Компилятор:
//     строка 3: `n` не объявлен как `mut` — присваивание запрещено
//
// `let` — это «только чтение». Хотите менять — пишите `let mut`.

fn needs_mut() {
    let n int = 1;
    // println(n);                 // читать можно
    let mut m int = 1;
    m = 2;                         // а менять — только mut
    println("mut работает: ", m, ", а n просто читается: ", n);
}

// ------------------------------------------------------------
// 7.3. Использование после перемещения
// ------------------------------------------------------------
//
//     struct U { n string; }
//     fn take(u U) { }
//
//     fn main() int {
//         let u = U("a");
//         take(u);                // владение ушло в take
//         println(u.n);           // ← u больше нет
//         return 0;
//     }
//
// Компилятор:
//     строка 7: `u` уже перемещён, использовать нельзя
//
// Это главная защита языка. В C++ здесь была бы копия и всё
// «работало» бы; в Rust — та же ошибка, что и здесь.

fn take(u User) {
    println("  забрали: ", u.name);
}

fn use_after_move() {
    let u User = User("John", 26);
    take(u);
    // println(u.name);            // ← ошибка: u уже перемещён
    println("  (после take переменной u нет — это проверено компилятором)");
}

// ------------------------------------------------------------
// 7.4. Ссылка на заменённый объект
// ------------------------------------------------------------
//
//     fn main() int {
//         let mut u = User("John", 26);
//         let r &User = &u;
//         u = User("Mary", 18);   // ← заменили весь объект
//         println(r.name);        // ← r указывает на старое место
//         return 0;
//     }
//
// Компилятор:
//     строка 5: ссылка `r` инвалидирована: объект `u` был изменён
//               или уничтожен
//
// Обратите внимание: инвалидируется ссылка на САМ объект `u`.
// Ссылка на поле `u.name` при изменении ДРУГОГО поля осталась бы
// живой — это и есть group borrowing.

fn invalidated_ref() {
    let mut u User = User("John", 26);
    let r &User = &u;
    println("ссылка жива: ", r.name);
    // u = User("Mary", 18);       // ← после этого r умерла бы
    println("(замена u здесь убила бы r — компилятор не дал бы)");
}

// ------------------------------------------------------------
// 7.5. Вызов изменяющего метода на неизменяемой переменной
// ------------------------------------------------------------
//
//     struct P { x int; }
//     impl P { fn inc(self &P) mut(self) { self.x = self.x + 1; } }
//
//     fn main() int {
//         let p = P(0);
//         p.inc();                // ← p не mut
//         return 0;
//     }
//
// Компилятор:
//     строка 4: `p` не объявлен как `mut` — вызов изменяет его,
//               а изменять неизменяемую переменную нельзя
//
// Контракт `mut(self)` в подписи метода — это и есть источник
// информации: компилятор знает, что `inc` меняет объект, и требует
// `let mut` у вызывающего.

struct P {
    x int;
}

impl P {
    fn inc(self &P) mut(self) {
        self.x = self.x + 1;
    }
}

fn needs_mut_for_method() {
    let mut p P = P(0);
    p.inc();
    p.inc();
    println("правильно (let mut p): ", p.x);
}

// ------------------------------------------------------------
// 7.6. Несовпадение типов
// ------------------------------------------------------------
//
//     fn main() int {
//         let x int = "строка";
//         return 0;
//     }
//
// Компилятор:
//     строка 2: несовпадение типов: объявлено `int`, получено `string`
//
// Неявного приведения нет. Строку с числом тоже нельзя сложить:
//
//     let s = "x = " + 5;
//     строка 1: арифметика требует int, получено `string` и `int`

fn type_mismatch() {
    let x int = 5;
    let s string = "пять";
    println("int: ", x, ", string: ", s);

    // Склеивать можно только строку со строкой:
    let msg string = "x = " + "5";
    println("склейка строк: ", msg);
}

// ------------------------------------------------------------
// 7.7. Неизвестное имя
// ------------------------------------------------------------
//
//     fn main() int {
//         println(nope);          // нет такой переменной
//         nope();                 // нет такой функции
//         return 0;
//     }
//
// Компилятор:
//     строка 2: неизвестная переменная `nope`
//     строка 3: неизвестная функция `nope`
//
// Опечатки ловятся сразу, а не в рантайме.

fn unknown_names() {
    let known int = 5;
    println("известное имя: ", known);
}

// ------------------------------------------------------------
// 7.8. Неверные аргументы
// ------------------------------------------------------------
//
//     fn add(a int) int { return a; }
//
//     fn main() int {
//         add(1, 2);              // лишний аргумент
//         add("x");               // не тот тип
//         return 0;
//     }
//
// Компилятор:
//     строка 4: `add` ждёт 1 аргумент, передан 2
//     строка 5: параметр `a` ожидает `int`, получен `string`
//
// Заметьте: «ждёт 1 аргумент», а не «1 аргументов» — сообщение
// согласовано по числу.

fn add(a int) int {
    return a;
}

fn wrong_args() {
    println("правильный вызов: ", add(1));
}

// ------------------------------------------------------------
// 7.9. Управление вне цикла
// ------------------------------------------------------------
//
//     fn main() int {
//         break;                  // ← не внутри цикла
//         return 0;
//     }
//
// Компилятор:
//     строка 2: `break` используется вне цикла
//
// То же для `continue`.

fn break_outside() {
    for i in 0..3 {
        if i == 1 {
            break;                 // внутри цикла — законно
        }
    }
    println("break внутри цикла — правильно");
}

// ------------------------------------------------------------
// 7.10. Обобщённые типы пока не поддержаны
// ------------------------------------------------------------
//
//     fn main() int {
//         let v Vec<int> = 1;
//         return 0;
//     }
//
// Компилятор:
//     ошибка: строка 2: обобщённые типы не поддерживаются в MVP,
//             используйте массивы [T; N]
//
// Это не «забыли сделать» — обобщённые типы в плане (волна 8).
// Пока используйте массивы фиксированного размера.

fn no_generics() {
    let a [int; 3] = [1, 2, 3];
    println("массив вместо Vec: ", len(a), " элемента");
}

// ------------------------------------------------------------
// 7.11. `const` внутри функции
// ------------------------------------------------------------
//
//     fn main() int {
//         const X = 5;            // ← const только на уровне файла
//         return 0;
//     }
//
// Компилятор:
//     ошибка: строка 2: `const` объявляется на уровне файла, вне
//             функции: его значение подставляется при компиляции
//             и не занимает памяти
//
// Константа — это подстановка значения, а не переменная. У неё нет
// места в стеке, поэтому объявить её внутри функции нельзя.

const GLOBAL_CONST = 5;

fn const_placement() {
    println("константа объявлена на уровне файла: ", GLOBAL_CONST);
}

// ------------------------------------------------------------
// 7.12. Что важно понять
// ------------------------------------------------------------
//
// Ошибки компилятора в Keel делятся на два вида:
//
//   1. **Разбор** (парсер) — «ожидалось ')', получено ';'».
//      Программа написана не по грамматике.
//
//   2. **Проверка** (проверщик) — «`u` уже перемещён».
//      Грамматика верна, но нарушена модель владения.
//
// Второй вид — то, ради чего язык существует. Компилятор ловит
// use-after-move, изменение без `mut`, инвалидацию ссылок — всё то,
// что в C даёт segfault, а в C++ тихо портит данные.

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 7.1. Забыли let ===");
    forgot_let();
    println();

    println("=== 7.2. Изменение без mut ===");
    needs_mut();
    println();

    println("=== 7.3. Использование после перемещения ===");
    use_after_move();
    println();

    println("=== 7.4. Ссылка на заменённый объект ===");
    invalidated_ref();
    println();

    println("=== 7.5. Метод на неизменяемой переменной ===");
    needs_mut_for_method();
    println();

    println("=== 7.6. Несовпадение типов ===");
    type_mismatch();
    println();

    println("=== 7.7. Неизвестное имя ===");
    unknown_names();
    println();

    println("=== 7.8. Неверные аргументы ===");
    wrong_args();
    println();

    println("=== 7.9. break вне цикла ===");
    break_outside();
    println();

    println("=== 7.10. Обобщённые типы ===");
    no_generics();
    println();

    println("=== 7.11. const внутри функции ===");
    const_placement();

    return 0;
}
