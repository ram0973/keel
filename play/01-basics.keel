// ============================================================
//  Keel — туториал
//  Часть 1. Основы: переменные, числа, строки, печать
// ============================================================
//
//  Как запускать:
//
//      cd ~/keel
//      ./target/debug/keelc run play/01-basics.keel
//
//  Проверить, не запуская:
//
//      ./target/debug/keelc check play/01-basics.keel
//
//  Собрать в отдельный файл (оставит и бинарник, и C-исходник):
//
//      ./target/debug/keelc compile play/01-basics.keel /tmp/basics
//
//  Каждый файл туториала — рабочая программа. Читайте сверху вниз
//  и запускайте: всё, что написано, компилятор действительно делает.
// ============================================================


// ------------------------------------------------------------
// 1.1. Первая программа
// ------------------------------------------------------------
//
// Точка входа — `fn main() int`. Она обязана вернуть int: это код
// возврата процесса (0 — успех). Компилятор не даст забыть return.
//
// `println` печатает значения и переводит строку.

fn hello() {
    println("Hello, world!");
}

// ------------------------------------------------------------
// 1.2. Переменные: `let` и `let mut`
// ------------------------------------------------------------
//
// Объявление: `let имя тип = значение;`
//
// Тип пишется ПОСЛЕ имени, без двоеточия: `x int`, а не `x: int`.
// Это главное синтаксическое отличие от Rust и Kotlin.
//
// `let` — обычная переменная: прочитать можно, присвоить нельзя.
// `let mut` — можно и переприсваивать.

fn variables() {
    let name string = "Keel";
    let year int = 2026;

    // `let mut` — разрешено менять.
    let mut counter int = 0;
    counter = counter + 1;
    counter += 1;              // то же самое, короче

    println("язык: ", name);
    println("год: ", year);
    println("counter: ", counter);
}

// ------------------------------------------------------------
// 1.3. Три типа
// ------------------------------------------------------------
//
// В языке три простых типа:
//
//     int      целое число (64 бита)
//     bool     true / false
//     string   строка UTF-8
//
// Строки сравниваются ПО СОДЕРЖИМОМУ, а не по адресу — как в Java,
// и в отличие от C, где `==` сравнивает указатели.

fn types() {
    let n int = 42;
    let b bool = true;
    let s string = "строка";

    println(n, " ", b, " ", s);

    // Сравнение строк — по содержимому.
    if "abc" == "abc" {
        println("строки равны по содержимому");
    }

    // Строки можно сравнивать и по порядку.
    if "apple" < "banana" {
        println("apple идёт раньше banana");
    }
}

// ------------------------------------------------------------
// 1.4. Печать
// ------------------------------------------------------------
//
// `println` принимает сколько угодно аргументов и печатает их
// подряд. Перевод строки — один раз, в самом конце.
//
// `print` делает то же, но БЕЗ перевода строки.

fn printing() {
    // Раньше приходилось писать так:
    println("имя: ");
    println("John");

    // Теперь так — одним вызовом:
    println("имя: ", "John", ", возраст: ", 26);

    // Без перевода строки:
    print("а");
    print("б");
    print("в");
    println();                 // завершить строку

    // Печать без аргументов — просто перевод строки.
    println();
}

// ------------------------------------------------------------
// 1.5. Числа и арифметика
// ------------------------------------------------------------

fn arithmetic() {
    let a int = 7;
    let b int = 3;

    println("a + b = ", a + b);      // 10
    println("a - b = ", a - b);      // 4
    println("a * b = ", a * b);      // 21
    println("a / b = ", a / b);      // 2  — целочисленное деление!
    println("a % b = ", a % b);      // 1  — остаток

    // ВНИМАНИЕ: деление целочисленное. 7 / 3 даёт 2, а не 2.33.
    // Дробных чисел (f64) в языке пока нет — это волна 2 плана.

    // Унарный минус работает:
    let neg int = -5;
    println("минус: ", -neg);
}

// ------------------------------------------------------------
// 1.6. Комментарии
// ------------------------------------------------------------
//
//     // до конца строки
//     /* блок */
//
// Комментарии не влияют ни на что: их выбрасывает лексер.

fn comments() {
    // Это строчный комментарий.
    /* А это
       блочный, на несколько строк. */
    println("комментарии не мешают");
}

// ------------------------------------------------------------
// 1.7. Константы
// ------------------------------------------------------------
//
// `const` объявляется на УРОВНЕ ФАЙЛА, вне функции.
//
// Константа подставляется своим значением прямо при компиляции —
// как `#define` в C. У неё нет ни адреса, ни места в памяти.
//
// Отсюда два следствия:
//   1. значение обязано быть известно компилятору;
//   2. константа годится для размера массива.

const APP_NAME = "Keel Tutorial";
const MAX_ITEMS = 5;
const VERSION = 1 + 1;              // арифметика вычисляется при компиляции
const LIMIT = MAX_ITEMS * 2;        // константа из константы
const DEBUG = true;

fn constants() {
    println(APP_NAME, " версия ", VERSION);
    println("MAX_ITEMS = ", MAX_ITEMS);
    println("LIMIT = ", LIMIT);
    println("DEBUG = ", DEBUG);
}

// ------------------------------------------------------------
// 1.8. Ввод и аргументы командной строки
// ------------------------------------------------------------
//
// До сих пор все данные были в самом коде. Теперь программа может
// их получать: из стандартного ввода и из аргументов запуска.

fn input() {
    // read_line() — строка целиком, до перевода строки.
    // Пробелы сохраняются: в отличие от scanf("%s") в C, имя
    // "Иван Петров" прочитается целиком.
    println("Как вас зовут?");
    let name string = read_line();
    println("Привет, ", name, "!");

    // read_int() — целое. Он читает СТРОКУ и разбирает её, поэтому
    // не оставляет перевод строки в буфере ввода: следующий
    // read_line прочитает следующую строку, а не пустоту.
    println("Сколько вам лет?");
    let age int = read_int();
    println("Через год будет ", age + 1);
}

fn args() {
    // argc() — сколько аргументов получила программа (включая имя
    // самой программы). argv(i) — i-й аргумент, всегда string.
    //
    // Запуск:
    //     keelc run play/01-basics.keel один два
    println("аргументов: ", argc());
    for i in 0..argc() {
        println("  ", i, ": ", argv(i));
    }
}

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 1.1. Первая программа ===");
    hello();
    println();

    println("=== 1.2. Переменные ===");
    variables();
    println();

    println("=== 1.3. Типы ===");
    types();
    println();

    println("=== 1.4. Печать ===");
    printing();
    println();

    println("=== 1.5. Арифметика ===");
    arithmetic();
    println();

    println("=== 1.6. Комментарии ===");
    comments();
    println();

    println("=== 1.7. Константы ===");
    constants();
    println();

    println("=== 1.8. Ввод и аргументы ===");
    input();
    println();
    args();

    return 0;
}
