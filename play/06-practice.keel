// ============================================================
//  Keel — туториал
//  Часть 6. Практика: телефонная книга
// ============================================================
//
//      ./target/debug/keelc run play/06-practice.keel
//
//  Здесь всё вместе: структуры, методы, массивы, циклы, владение,
//  mut-контракты, len, конкатенация строк.
//
//  Программа — маленькая телефонная книга с фиксированной ёмкостью.
//  Растущего списка (Vec) в языке пока нет, поэтому массив
//  фиксированного размера и счётчик занятых ячеек.
// ============================================================

const CAPACITY = 5;

struct Contact {
    name string;
    phone string;
}

struct PhoneBook {
    items [Contact; CAPACITY];
    count int;
}

// ------------------------------------------------------------
// 6.1. Методы книги
// ------------------------------------------------------------
//
// `mut(self)` — метод меняет книгу. Вызывающий обязан объявить
// переменную как `let mut`.

impl PhoneBook {
    // Создать пустую книгу. Ассоциированная функция — без `self`,
    // вызывается как `PhoneBook::new()`.
    fn new() PhoneBook {
        // Заполняем массив пустыми записями: в языке нет
        // «объявления без инициализатора», нужен явный литерал.
        return PhoneBook(
            [
                Contact("", ""), Contact("", ""), Contact("", ""),
                Contact("", ""), Contact("", "")
            ],
            0
        );
    }

    // Добавить контакт. Возвращает true, если поместилось.
    fn add(self &PhoneBook, name string, phone string) bool mut(self) {
        // Проверяем, есть ли место. `self.count` — счётчик занятых.
        if self.count >= CAPACITY {
            return false;
        }

        // Кладём запись в первую свободную ячейку.
        self.items[self.count] = Contact(name, phone);
        self.count = self.count + 1;
        return true;
    }

    // Найти телефон по имени. Возвращает строку; пустая строка —
    // «не найдено». В языке нет Option — это волна 8 плана.
    fn find(self &PhoneBook, name string) string {
        for i in 0..self.count {
            // Сравнение строк — по содержимому, поэтому `==` работает.
            if self.items[i].name == name {
                return self.items[i].phone;
            }
        }
        return "";
    }

    // Сколько записей.
    fn size(self &PhoneBook) int {
        return self.count;
    }

    // Напечатать всю книгу.
    fn print_all(self &PhoneBook) {
        println("--- телефонная книга (", self.count, " из ", CAPACITY, ") ---");
        for i in 0..self.count {
            println("  ", i + 1, ". ", self.items[i].name, ": ", self.items[i].phone);
        }
    }
}

// ------------------------------------------------------------
// 6.2. Работа с книгой
// ------------------------------------------------------------

fn demo() {
    // `let mut` — книга будет меняться.
    let mut book PhoneBook = PhoneBook::new();

    // Добавляем контакты. `add` возвращает bool — проверяем результат.
    book.add("John", "+7-900-123-45-67");
    book.add("Mary", "+7-900-765-43-21");
    book.add("James", "+7-900-111-22-33");

    book.print_all();
    println();

    // Поиск: сравнение строк по содержимому.
    let found string = book.find("Mary");
    if found == "" {
        println("Mary не найдена");
    } else {
        println("Mary: ", found);
    }

    let missing string = book.find("Nobody");
    if missing == "" {
        println("Nobody не найден (пустая строка = не найдено)");
    }
    println();

    // Заполняем книгу до отказа — проверяем границу.
    book.add("Leila", "+7-900-444-55-66");
    book.add("Anna", "+7-900-777-88-99");
    println("после заполнения: ", book.size(), " записей");

    // Шестая запись не поместится: `add` вернёт false.
    let ok bool = book.add("TooMany", "+7-000-000-00-00");
    println("шестая запись добавилась? ", ok);
    println("в книге всё ещё: ", book.size(), " записей");
}

// ------------------------------------------------------------
// 6.3. Почему так, а не иначе
// ------------------------------------------------------------
//
// **Почему фиксированный размер.** Растущего массива (Vec) в языке
// пока нет — это волна 8 плана. Массив `[Contact; 5]` — часть типа,
// его размер известен компилятору, поэтому `len` работает без
// рантайма.
//
// **Почему пустые записи.** Объявления без инициализатора нет:
//     let items [Contact; 5];        // ошибка
// Поэтому массив заполняется пустыми `Contact("", "")`, а счётчик
// `count` говорит, сколько ячеек занято. Это классический приём C.
//
// **Почему пустая строка вместо «не найдено».** Типа «значение или
// ничего» (Option) в языке нет. Возврат пустой строки — способ из C;
// в волне 8 появится Option, и `find` станет честнее.
//
// **Почему `mut(self)`.** Метод `add` меняет книгу, и это видно
// в подписи. Вызывающий знает: нужен `let mut`. В C++ по вызову
// `book.add(...)` понять это невозможно — метод может менять
// объект, а может нет, и это не написано в заголовке.

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 6. Телефонная книга ===");
    demo();

    return 0;
}
