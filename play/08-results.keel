// ============================================================
//  Keel — туториал
//  Часть 8. Option, Result и оператор `?`
// ============================================================
//
//      ./target/debug/keelc run play/08-results.keel
//
//  Ошибка в Keel — это не «программа упала», а значение, которое
//  разбирают. Есть два вида:
//
//      Option<T>   — значения или нет:  Some(5) / None
//      Result<T,E> — успех или ошибка:  Ok(5) / Err("плохо")
//
//  Разбор — `match`, и он исчерпывающий: забыть ветку нельзя.
// ============================================================


// ------------------------------------------------------------
// 8.1. Option: значения может не оказаться
// ------------------------------------------------------------
//
// Option<T> — встроенный enum с вариантами Some(T) и None.
// Он отвечает на вопрос «а есть ли значение?», а не «какая ошибка».

fn find_first(names [string]) Option<string> {
    if len(names) == 0 {
        return None;
    }
    return Some(names[0]);
}

fn option_basics() {
    let names [string; 2] = ["Аня", "Борис"];

    // Разбор — `match`, и он исчерпывающий.
    match find_first(names) {
        Some(n) => { println("первый: ", n); }
        None => { println("список пуст"); }
    }

    let empty [string; 0] = [];
    match find_first(empty) {
        Some(n) => { println("первый: ", n); }
        None => { println("список пуст"); }
    }
}

// ------------------------------------------------------------
// 8.2. Короткие методы вместо match
// ------------------------------------------------------------
//
// Когда разбирать нечего, есть методы:
//
//     unwrap()      значение; на None — сообщение и выход с кодом 1
//     unwrap_or(x) значение или запасное x
//     is_some()    есть ли значение
//     is_none()    нет ли значения

fn option_methods() {
    let some Option<int> = Some(5);
    let none Option<int> = None;

    println("is_some: ", some.is_some());
    println("is_none: ", none.is_none());
    println("unwrap_or: ", none.unwrap_or(0));
    println("unwrap_or: ", some.unwrap_or(0));
}

// ------------------------------------------------------------
// 8.3. Result: успех или ошибка
// ------------------------------------------------------------
//
// Result<T,E> — Ok(T) и Err(E). Разбор — тоже `match`.
//
// Отличие от Option: в Err лежит *почему* не получилось.

fn divide(a int, b int) Result<int, string> {
    if b == 0 {
        return Err("деление на ноль");
    }
    return Ok(a / b);
}

fn result_basics() {
    match divide(10, 2) {
        Ok(v) => { println("10/2 = ", v); }
        Err(e) => { println("ошибка: ", e); }
    }

    match divide(10, 0) {
        Ok(v) => { println("10/0 = ", v); }
        Err(e) => { println("ошибка: ", e); }
    }
}

// ------------------------------------------------------------
// 8.4. Оператор `?` — пропагация ошибки
// ------------------------------------------------------------
//
// `expr?` — короткая запись для «если Err, верни его дальше;
// иначе продолжи со значением».
//
// Без `?` то же самое писалось бы вчетверо длиннее:
//
//     match parse(s) {
//         Ok(a) => { ... }
//         Err(e) => { return Err(e); }
//     }

fn parse(s string) Result<int, string> {
    if s == "42" {
        return Ok(42);
    }
    return Err("не число");
}

fn double(x int) Result<int, string> {
    return Ok(x * 2);
}

fn chain(s string) Result<int, string> {
    let a = parse(s)?;      // Err → сразу return Err(...)
    let b = double(a)?;     // Err → сразу return Err(...)
    return Ok(b + 1);
}

fn propagation() {
    match chain("42") {
        Ok(v) => { println("ок: ", v); }
        Err(e) => { println("ошибка: ", e); }
    }

    match chain("нет") {
        Ok(v) => { println("ок: ", v); }
        Err(e) => { println("ошибка: ", e); }
    }
}

// ------------------------------------------------------------
// 8.5. Правила оператора `?`
// ------------------------------------------------------------
//
//     ? требует `Result`, а не `Option`:
//         Option — это отсутствие значения, у него нет «ошибки».
//
//     ? требует, чтобы функция сама возвращала `Result`:
//         ошибку некуда возвращать, если функция возвращает не Result.
//
//     ? требует, чтобы тип ошибки совпадал с ошибкой функции:
//         Result<int, string> в функции, возвращающей
//         Result<int, string>.
//
// Для Option остаются `unwrap`/`unwrap_or` и `if let`.
//
// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 8.1. Option ===");
    option_basics();
    println();

    println("=== 8.2. Короткие методы ===");
    option_methods();
    println();

    println("=== 8.3. Result ===");
    result_basics();
    println();

    println("=== 8.4. Оператор ? ===");
    propagation();

    return 0;
}
