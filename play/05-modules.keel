// ============================================================
//  Keel — туториал
//  Часть 5. Модули
// ============================================================
//
//      ./target/debug/keelc run play/05-modules.keel
//
//  Модуль в Keel — это просто файл. Подключение — `import "путь"`.
//
//  Модель проще, чем в Rust, Java и Python:
//
//    * нет объявления модуля внутри файла — модуль ЕСТЬ файл;
//    * нет префиксов: имена плоские, `User` а не `user::User`;
//    * нет `pub` — сейчас видно всё (приватность в плане, волна 7);
//    * нет `import as`, `from ... import`, вложенных путей.
//
//  Путь пишется ОТНОСИТЕЛЬНО импортирующего файла. Этот файл лежит
//  в `play/`, значит `import "user.keel"` — это `play/user.keel`.
// ============================================================

import "user.keel";

// ------------------------------------------------------------
// 5.1. Что даёт import
// ------------------------------------------------------------
//
// После импорта в этом файле доступны ВСЕ объявления из user.keel:
// структура `User` и её методы из `impl User`.
//
// Обратите внимание: пишем `User(...)`, а не `user::User(...)`.
// Префикса с именем файла нет — это главное отличие от Rust.

fn using_imported() {
    let u User = User("John", 26);

    println("имя: ", u.name);
    println("возраст: ", u.age);

    // Методы из импортированного файла тоже видны:
    println("через метод: ", u.get_name());
}

// ------------------------------------------------------------
// 5.2. Свой тип рядом с импортированным
// ------------------------------------------------------------
//
// В этом файле можно объявлять свои структуры — они не конфликтуют
// с импортированными, если имена разные.

struct Group {
    title string;
    // Поле импортированного типа — работает как обычно.
    leader User;
    members [User; 3];
}

fn own_types() {
    let g Group = Group(
        "Разработка",
        User("Mary", 18),
        [User("John", 26), User("Mary", 18), User("James", 18)]
    );

    println("группа: ", g.title);
    println("руководитель: ", g.leader.get_name());

    for u in g.members {
        println("  участник: ", u.name, ", ", u.age);
    }
}

// ------------------------------------------------------------
// 5.3. Как устроен файл модуля
// ------------------------------------------------------------
//
// Посмотрите `play/user.keel` — там всего 16 строк:
//
//     struct User {
//         name string;
//         age int;
//     }
//
//     impl User {
//         fn get_name(self &User) string {
//             return self.name;
//         }
//     }
//
// Ни `module user`, ни `pub`, ни экспорта — файл целиком и есть
// модуль. Всё, что в нём объявлено, доступно импортирующему.

// ------------------------------------------------------------
// 5.4. Правила, которые стоит знать
// ------------------------------------------------------------
//
// 1. Один файл подключается ОДИН РАЗ, даже если его импортируют
//    несколько файлов. Ромбовидный импорт безопасен:
//
//        main.keel  ->  a.keel  ->  common.keel
//                   ->  b.keel  ->  common.keel
//
//    `common.keel` загрузится один раз.
//
// 2. ЦИКЛ — ошибка. Если a.keel импортирует b.keel, а b.keel — a.keel,
//    компилятор скажет:
//
//        цикл импорта: a.keel → b.keel → a.keel
//
// 3. Нет файла — понятная ошибка с путём:
//
//        не удалось открыть '.../nope.keel'
//
// 4. Путь считается от импортирующего файла, а не от корня проекта.
//    Поэтому `import "user.keel"` и `import "sub/user.keel"` — оба
//    законны, если файлы лежат рядом.

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 5.1. Что даёт import ===");
    using_imported();
    println();

    println("=== 5.2. Свой тип рядом с импортированным ===");
    own_types();

    return 0;
}
