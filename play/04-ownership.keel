// ============================================================
//  Keel — туториал
//  Часть 4. Владение и ссылки
// ============================================================
//
//      ./target/debug/keelc run play/04-ownership.keel
//
//  Это самая важная часть туториала. Читайте медленно.
//
//  Модель памяти Keel:
//
//    * у каждого значения РОВНО ОДИН владелец;
//    * передача без `&` — ПЕРЕМЕЩЕНИЕ: владелец меняется;
//    * передача с `&` — ЗАИМСТВОВАНИЕ: владелец остаётся;
//    * ссылка помнит ПУТЬ, на который указывает;
//    * изменение объекта инвалидирует ссылки ВНУТРЬ него.
//
//  Отличия от Rust:
//
//    * нет lifetime-аннотаций ('a) — вместо них пути;
//    * один вид ссылки `&T`, нет отдельного `&mut`;
//    * разыменование автоматическое, нет `*`;
//    * право писать даёт `mut`-контракт, а не вид ссылки.
// ============================================================


struct User {
    name string;
    age int;
}

// ------------------------------------------------------------
// 4.1. Перемещение: без `&` владелец меняется
// ------------------------------------------------------------
//
// Функция без `&` в параметре ЗАБИРАЕТ значение. После вызова
// у вызывающего его больше нет — компилятор это проверит.

fn consume(u User) {
    println("забрали: ", u.name);
}

fn moving() {
    let u User = User("John", 26);

    // Передаём без `&` — владение переходит в `consume`.
    consume(u);

    // Строка ниже НЕ скомпилируется:
    //     println(u.name);
    //     ошибка: `u` уже перемещён, использовать нельзя
    //
    // Это то же самое, что в Rust, и принципиально другое, чем в C++,
    // где вызывается конструктор копирования и оригинал остаётся жив.

    println("после consume переменной u больше нет");
}

// ------------------------------------------------------------
// 4.2. Заимствование: с `&` владелец остаётся
// ------------------------------------------------------------
//
// `&T` — ссылка. Объект остаётся у вызывающего, функция только
// смотрит. Это способ передать структуру, не теряя её.

fn observe(u &User) {
    println("смотрим: ", u.name, ", ", u.age);
}

fn borrowing() {
    let u User = User("Mary", 18);

    // Передаём ссылку — владение остаётся здесь.
    observe(&u);
    observe(&u);              // можно сколько угодно раз

    // И переменная по-прежнему наша:
    println("после observe: ", u.name);
}

// ------------------------------------------------------------
// 4.3. Ссылка на переменную
// ------------------------------------------------------------
//
// Ссылку можно сохранить в переменную. Тип — `&T`.

fn references() {
    let u User = User("James", 18);

    let r &User = &u;
    println("через ссылку: ", r.name);

    // Разыменование АВТОМАТИЧЕСКОЕ: пишем `r.name`, а не `(*r).name`
    // или `r->name`. Символа `*` в языке нет вовсе.

    // Ссылка на элемент массива тоже работает:
    let nums [int; 3] = [10, 20, 30];
    let first &int = &nums[0];
    println("первый элемент: ", first);
}

// ------------------------------------------------------------
// 4.4. Что такое «путь»
// ------------------------------------------------------------
//
// Ссылка помнит не просто «объект», а ПУТЬ к нему: `u`, `u.name`,
// `world.entities[2]`. Это важно: изменение одного поля
// инвалидирует ссылки внутрь именно этого места, а не всё подряд.

fn paths() {
    let mut nums [int; 3] = [10, 20, 30];

    // Две ссылки на РАЗНЫЕ элементы — обе живы. Это и есть
    // group borrowing: ссылки на разные части объекта не мешают
    // друг другу.
    let a &int = &nums[0];
    let b &int = &nums[1];
    println("a = ", a, ", b = ", b);

    // Меняем элемент 2 — на ссылки a и b это не влияет.
    nums[2] = 99;
    println("после изменения nums[2]: a = ", a, ", b = ", b);

    // А вот так НЕЛЬЗЯ (не скомпилируется):
    //     let r &int = &nums[0];
    //     nums = [1, 2, 3];       // заменили весь массив
    //     println(r);
    //     ошибка: ссылка `r` инвалидирована: объект `nums` был изменён
}

// ------------------------------------------------------------
// 4.5. Мутация: `let mut` и `mut`-контракт
// ------------------------------------------------------------
//
// Право писать даёт НЕ ссылка, а `mut`. Два условия:
//
//   1. переменная объявлена `let mut`;
//   2. функция объявила контракт `mut(путь)`.
//
// Контракт называет КОНКРЕТНЫЙ путь, который функция меняет:
//
//     mut(x)        меняет саму переменную x
//     mut(c.n)      меняет поле n объекта c
//     mut(a[])      меняет элементы массива a
//
// `mut(a[])` — шаблон: «все элементы массива a». Так пишут, когда
// функция меняет содержимое массива, но не сам массив.

// Меняем элементы массива целиком — контракт `mut(a[])`.
fn reset(a &[int; 3]) mut(a[]) {
    for i in 0..len(a) {
        a[i] = 0;
    }
}

// Меняем одно поле структуры — контракт называет путь до поля.
struct Account {
    balance int;
}

fn deposit(acc &Account, amount int) mut(acc.balance) {
    acc.balance = acc.balance + amount;
}

fn mutation() {
    // Без `mut` вызов не скомпилируется:
    //     let n [int; 3] = [1, 2, 3];
    //     reset(&n);
    //     ошибка: `n` не объявлен как `mut` — вызов изменяет его
    let mut nums [int; 3] = [1, 2, 3];
    reset(&nums);
    println("после reset: ", nums[0], " ", nums[1], " ", nums[2]);

    let mut acc Account = Account(100);
    deposit(&acc, 50);
    deposit(&acc, 25);
    println("баланс: ", acc.balance);
}

// ------------------------------------------------------------
// 4.5.1. Почему `&int` нельзя изменить напрямую
// ------------------------------------------------------------
//
// Ссылка на простое число — это указатель на значение. Присваивание
// `x = 5` внутри функции пытается заменить САМУ ССЫЛКУ, а не то,
// на что она указывает, — и типы не сходятся:
//
//     fn bump(x &int) mut(x) { x = x + 1; }
//     ошибка: несовпадение типов при присваивании: `&int` и `int`
//
// В языке нет `*x = ...` (символа `*` нет вовсе), поэтому менять
// через ссылку на скаляр нечего. Меняйте через структуру или массив
// — там путь называет поле или элемент:
//
//     fn deposit(acc &Account, amount int) mut(acc.balance) {
//         acc.balance = acc.balance + amount;      // работает
//     }
//
// Это осознанное ограничение, а не недоделка: путь `acc.balance`
// называет конкретное место, и компилятор точно знает, что меняется.

// ------------------------------------------------------------
// 4.6. Методы: `self &T` и `mut(self)`
// ------------------------------------------------------------
//
// Метод — та же функция, `self` — обычный параметр.
//
//     self &T          смотрит, объект остаётся у вызывающего
//     self T           забирает объект насовсем
//     mut(self)        изменяет объект (нужен `let mut`)

struct Counter {
    value int;
}

impl Counter {
    fn get(self &Counter) int {
        return self.value;
    }

    fn inc(self &Counter) mut(self) {
        self.value = self.value + 1;
    }
}

fn methods_ownership() {
    let mut c Counter = Counter(0);
    c.inc();
    c.inc();
    println("счётчик: ", c.get());

    // Почему `self &T`, а не `self T`? Потому что метод не забирает
    // объект: после вызова `c` жив. Если написать `self Counter`,
    // объект переместился бы в метод и `c` стало бы недоступно.
}

// ------------------------------------------------------------
// 4.7. Работа с массивом структур
// ------------------------------------------------------------
//
// Самый частый практический случай: есть массив, обходим его
// по ссылке и что-то считаем.

fn total_age(users &[User; 3]) int {
    let mut sum int = 0;
    for i in 0..len(users) {
        // `users[i]` — элемент по ссылке на массив; `.age` читается
        // автоматически.
        sum += users[i].age;
    }
    return sum;
}

fn array_of_structs() {
    let users [User; 3] = [
        User("John", 26),
        User("Mary", 18),
        User("James", 18),
    ];

    // Передаём массив по ссылке — он остаётся у нас.
    println("суммарный возраст: ", total_age(&users));

    // Обход по значению тоже работает: элемент копируется
    // в переменную цикла.
    for u in users {
        println("  ", u.name);
    }
}

// ------------------------------------------------------------
// 4.8. Затенение
// ------------------------------------------------------------
//
// Область видимости ПЛОСКАЯ: второе `let` с тем же именем затеняет
// первое. В C-коде компилятор разводит их (`x`, `x__1`), так что
// затенение безопасно.

fn shadowing() {
    let x int = 1;
    println("первое x: ", x);

    let x int = 2;            // затеняет первое
    println("второе x: ", x);

    // Переменная цикла тоже затеняет внешнюю:
    let i int = 99;
    for i in 0..2 {
        println("цикловое i: ", i);
    }
    println("внешнее i не пострадало: ", i);
}

// ------------------------------------------------------------
// 4.9. Ссылка не переживает функцию
// ------------------------------------------------------------
//
// Ссылка привязана к месту, где создана. Если это локальная
// переменная — вместе с ней умирает и ссылка. Вернуть такую ссылку
// наружу нельзя.
//
// Это единственное правило языка, которое нельзя понять по коду
// в одной функции: оно про границу между функциями.

struct Inner {
    x int;
}

struct Holder {
    r &Inner;
}

// ТАК НЕЛЬЗЯ (не скомпилируется):
//
//     fn make() Holder {
//         let i = Inner(42);
//         return Holder(&i);      // ← i умрёт вместе с кадром
//     }
//
// Компилятор скажет:
//     поле `r` возвращаемого значения содержит ссылку на локальную
//     переменную `i` — она перестанет существовать после возврата;
//     вернуть можно только ссылку на параметр
//
// Почему: `i` живёт на стеке `make`, а `Holder` переживёт возврат.
// Чтение `h.r.x` после возврата дало бы мусор — use-after-free.
// Компилятор C такое не ловит: для него это обычный указатель.

// ТАК МОЖНО: ссылка на параметр. Параметр живёт в кадре
// вызывающего, который переживёт наш кадр.
fn make(x &Inner) Holder {
    return Holder(x);
}

// И внутри одной функции ссылка на локальную разрешена:
fn local_reference() {
    let i Inner = Inner(42);
    let h Holder = Holder(&i);      // законно: h не покидает функцию
    println("через ссылку в поле: ", h.r.x);
}

// Тот же запрет — на запись в поле параметра: это тоже выход за
// пределы кадра.
//
//     fn f(h &Holder) mut(h.r) {
//         let i = Inner(42);
//         h.r = &i;                   // ← ошибка
//     }

fn escape_analysis() {
    // Ссылка на параметр возвращается наружу — законно.
    let i Inner = Inner(42);
    let h Holder = make(&i);
    println("ссылка на параметр: ", h.r.x);

    // Ссылка на локальную внутри функции — законно.
    local_reference();
}

// ------------------------------------------------------------
// main
// ------------------------------------------------------------

fn main() int {
    println("=== 4.1. Перемещение ===");
    moving();
    println();

    println("=== 4.2. Заимствование ===");
    borrowing();
    println();

    println("=== 4.3. Ссылки ===");
    references();
    println();

    println("=== 4.4. Пути ===");
    paths();
    println();

    println("=== 4.5. Мутация ===");
    mutation();
    println();

    println("=== 4.6. Методы и владение ===");
    methods_ownership();
    println();

    println("=== 4.7. Массив структур ===");
    array_of_structs();
    println();

    println("=== 4.8. Затенение ===");
    shadowing();
    println();

    println("=== 4.9. Ссылка не переживает функцию ===");
    escape_analysis();

    return 0;
}
