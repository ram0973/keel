// Файлы: запись, чтение, закрытие.
//
// `open(path, mode)` возвращает fd или -1. Режим — как в C: "r", "w", "a".
// `read(fd)` читает файл целиком в строку, `write(fd, s)` пишет строку,
// `close(fd)` закрывает. Память под прочитанную строку освобождается при
// выходе программы (как и у read_line); раннее освобождение — волна 8.

fn main() int {
    let path = "/tmp/keel_files_example.txt";

    let fd = open(path, "w");
    if fd < 0 {
        println("не удалось открыть на запись");
        return 1;
    }
    write(fd, "первая строка\n");
    write(fd, "вторая строка\n");
    close(fd);

    let rfd = open(path, "r");
    if rfd < 0 {
        println("не удалось открыть на чтение");
        return 1;
    }
    let content = read(rfd);
    close(rfd);

    print(content);
    return 0;
}
