// Волна 7 (продолжение): ввод и аргументы командной строки.
//
// Запуск:
//     keelc run examples/wave7-io.keel Аня Борис
//
// Или с вводом из файла:
//     keelc run examples/wave7-io.keel < input.txt

// ------------------------------------------------------------
// 1. read_line — строка целиком, пробелы сохраняются
// ------------------------------------------------------------

fn greet() {
    println("Как вас зовут?");
    let name string = read_line();
    println("Привет, ", name, "!");
}

// ------------------------------------------------------------
// 2. read_int — целое, и он НЕ ломает следующий read_line
// ------------------------------------------------------------
//
// `read_int` читает строку и разбирает её, а не `scanf("%lld")`.
// Поэтому перевод строки не остаётся в буфере ввода, и `read_line`
// после него читает следующую строку, а не пустоту.

fn sum_two() {
    println("Два числа, каждое на своей строке:");
    let a int = read_int();
    let b int = read_int();
    println(a, " + ", b, " = ", a + b);
}

// ------------------------------------------------------------
// 3. Чтение до конца ввода
// ------------------------------------------------------------
//
// В конце ввода read_line возвращает пустую строку — в языке нет
// Option, а NULL печатать нельзя.

fn count_lines() {
    let mut n int = 0;
    let mut line string = read_line();
    while len(line) > 0 {
        n = n + 1;
        line = read_line();
    }
    println("прочитано строк: ", n);
}

// ------------------------------------------------------------
// 4. argc / argv — аргументы командной строки
// ------------------------------------------------------------
//
// argv(0) — имя программы. Выход за границы даёт пустую строку,
// а не падение: размер массива известен только в рантайме.

fn show_args() {
    println("аргументов: ", argc());
    for i in 0..argc() {
        println("  ", i, ": ", argv(i));
    }
}

// ------------------------------------------------------------
// 5. Аргументы как данные программы
// ------------------------------------------------------------

fn longest_arg() {
    if argc() < 2 {
        println("передайте хотя бы один аргумент");
        return;
    }
    let mut best string = argv(1);
    for i in 1..argc() {
        let cur string = argv(i);
        if len(cur) > len(best) {
            best = cur;
        }
    }
    println("самый длинный аргумент: ", best, " (", len(best), " байт)");
}

fn main() int {
    println("=== 1. read_line ===");
    greet();
    println();

    println("=== 2. read_int + read_line ===");
    sum_two();
    println();

    println("=== 3. чтение до конца ввода ===");
    count_lines();
    println();

    println("=== 4. argc / argv ===");
    show_args();
    println();

    println("=== 5. аргументы как данные ===");
    longest_arg();

    return 0;
}
