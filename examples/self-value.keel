// Зачем нужен self без & — на одном примере.
//
// Короткий ответ: чтобы метод мог ПОЛОЖИТЬ СЕБЯ внутрь другой структуры.
// С `self &T` это невозможно: параметр — ссылка, а поле структуры хочет
// значение, а разыменовать вручную (`*self`) в Keel нельзя — оператора
// `*` в языке нет.

struct User {
    name string;
    age int;
}

struct Wrapper {
    user User;
    tag int;
}

impl User {
    // --- ПРОБЛЕМА ---
    //
    // Так НЕ получится:
    //
    //   fn wrap(self &User) Wrapper {
    //       return Wrapper(self, 1);
    //   }
    //
    // Ошибка: `аргумент `user`: ожидался `User`, получен `&User``.
    // Поле структуры принимает ЗНАЧЕНИЕ, а `self` здесь — ссылка.
    // Обойти нечем: `*self` не существует, оператора `*` в Keel нет.

    // --- РЕШЕНИЕ: self по значению ---
    //
    // `self User` забирает объект внутрь метода. Теперь это полноценное
    // значение, и его можно положить в поле.
    fn wrap(self User) Wrapper {
        return Wrapper(self, 1);
    }

    // Для сравнения: читающий метод. Здесь хватает ссылки,
    // и объект остаётся у вызывающего.
    fn get_name(self &User) string {
        return self.name;
    }
}

fn main() int {
    let u = User("John", 26);

    // Читающий метод: `u` остаётся жив.
    println(u.get_name());     // John
    println(u.get_name());     // John — можно ещё раз

    // Поглощающий метод: `u` уходит внутрь обёртки.
    let w = u.wrap();
    println(w.tag);            // 1
    println(w.user.name);      // John

    // println(u.age);         // ошибка: `u` уже перемещён

    return 0;
}
