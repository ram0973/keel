// ============================================================================
// Keel — экскурсия по языку
// ============================================================================
//
// Это работающая программа и одновременно документация. Каждый раздел
// показывает одну возможность языка; комментарии объясняют, что именно
// происходит и почему это важно.
//
// Запуск:
//     cargo run -- run examples/language-tour.keel
//
// Разделы:
//     1. Типы и значения
//     2. Структуры и массивы
//     3. Функции: владение, ссылка, параметр-внутри
//     4. Владение и move
//     5. Ссылки помнят путь
//     6. Контракт mut
//     7. То, что Rust запрещает
//     8. Управление потоком
//     9. Что Keel запрещает и как это решать правильно
//    10. Словарь языка
//
// ============================================================================


// ============================================================================
// 1. ТИПЫ И ЗНАЧЕНИЯ
// ============================================================================
//
// Четыре базовых типа: int (64-битный целый), bool, string, void.
// Числовых суффиксов нет — тип выводится. Литералы с точкой — вещественные
// (в MVP вещественные пока не поддержаны в полном объёме).
//
// Значения по умолчанию неизменяемы: переприсваивание требует `let mut`.

fn demo_types() int {
    println("=== 1. типы и значения ===");

    let n = 42;            // int
    let flag = true;       // bool
    let name = "orc";      // string

    println(n);              // 42
    println(flag);           // true
    println(name);           // orc

    // Переприсваивание требует `mut`.
    let mut counter = 0;
    counter = counter + 1;
    counter = counter + 10;
    println(counter);        // 11

    // Без `mut` — ошибка компиляции (см. раздел 9).
    // let frozen = 1;
    // frozen = 2;          // ошибка: `frozen` не объявлен как `mut`

    return 0;
}


// ============================================================================
// 2. СТРУКТУРЫ И МАССИВЫ
// ============================================================================
//
// Структура объявляется через `struct`, поля — `имя тип;`.
// Конструктор — вызов по имени класса с позиционными аргументами:
// `Point(3, 4)`. Именованных аргументов нет.
//
// Массив — `[T; N]`, фиксированного размера. Литерал: `[a, b, c]`.
// Доступ по индексу: `arr[0]`.
//
// Именованной инициализации (`Point { x: 3, y: 4 }`) в Keel нет: позиционная
// короче, а порядок полей виден в объявлении структуры.

struct Point {
    x int;
    y int;
}

struct Entity {
    hp int;
    name string;
}

// Структура может содержать массив, а массив — структуры.
struct World {
    entities [Entity; 3];
    alive int;
}

fn demo_structs() int {
    println("=== 2. структуры и массивы ===");

    // Конструктор: позиционные аргументы в порядке полей.
    let p = Point(3, 4);
    println(p.x);               // 3
    println(p.y);               // 4

    // Массив структур: литерал.
    let points = [Point(1, 1), Point(2, 4), Point(3, 9)];
    println(points[0].x);       // 1
    println(points[2].y);       // 9

    // Поле-массив в структуре.
    let w = world_of(Entity(10, "orc"), Entity(20, "rat"), Entity(30, "bat"));
    println(w.entities[1].name);// rat
    println(w.alive);           // 3

    // Структура — значение, а не ссылка: копируется при передаче.
    println(p.x + p.y);         // 7

    // Пустой массив: тип элемента объявляется явно, длина — ноль.
    // Без явного типа компилятор не знает, что за элементы.
    let empty [int; 0] = [];
    let empty_entities [Entity; 0] = [];
    println("пустой массив создан");
    return 0;
}


// ============================================================================
// 3. ФУНКЦИИ: ВЛАДЕНИЕ, ССЫЛКА, ПАРАМЕТР-ВНУТРИ
// ============================================================================
//
// Три вида параметров — это ядро языка.
//
//   fn f(p Point)         — владение: значение перемещается в функцию.
//   fn f(p &Point)        — ссылка: функция видит объект, но не владеет им.
//   fn f(e in world.ents[]) — ссылка внутрь: элемент коллекции.
//
// Возвращаемый тип пишется после скобки параметров: `fn f(x int) int`.
// Тип возврата можно опустить — тогда `void`.
//
// Отличие от Rust: нет `->`, нет lifetime-аннотаций, один вид ссылки.

// Владение: значение перемещается в функцию.
fn area(p Point) int {
    return p.x * p.y;
}

// Ссылка: функция получает доступ к объекту.
// `mut` на параметре означает: «эта функция меняет содержимое p».
fn shift(p &Point mut, dx int) {
    p.x = p.x + dx;
}

// Ссылка внутрь: `e` — один из элементов `world.entities`.
// Конструктор `World(...)` создаёт структуру с массивом.
fn world_of(e0 Entity, e1 Entity, e2 Entity) World {
    return World([e0, e1, e2], 3);
}

fn demo_functions() int {
    println("=== 3. функции: владение, ссылка, параметр-внутри ===");

    // Владение: p копируется (структуры не Copy — но здесь значение
    // передаётся по владению и сразу используется).
    let p = Point(3, 4);
    println(area(p));           // 12 — p перемещён, использовать нельзя

    // Ссылка: функция меняет объект вызывающего.
    let mut q = Point(10, 20);
    shift(&q, 5);
    println(q.x);               // 15 — shift изменила объект вызывающего

    // Параметр-внутри: элемент коллекции.
    let mut w = world_of(Entity(100, "orc"), Entity(80, "goblin"), Entity(50, "rat"));
    damage(&w, &w.entities[1], 30);
    println(w.entities[1].hp);  // 50

    return 0;
}


// ============================================================================
// 4. ВЛАДЕНИЕ И MOVE
// ============================================================================
//
// Каждое значение имеет одного владельца. Передача аргументом или
// присваивание перемещает значение: старый владелец больше не может им
// пользоваться.
//
// Типы int, bool, string копируются (Copy). Структуры и массивы — нет.
//
// Это ловится на этапе компиляции, а не в рантайме.

fn consume(p Point) int {
    return p.x;
}

fn demo_move() int {
    println("=== 4. владение и move ===");

    let p = Point(10, 20);
    let area_value = consume(p);   // p перемещён в consume
    println(area_value);              // 10

    // Использовать p после перемещения — ошибка компиляции (раздел 9):
    // println(p.y);

    // А вот целые числа копируются, p можно использовать дальше:
    let n = 5;
    let m = consume_int(n);
    println(n + m);                  // 10
    return 0;
}

fn consume_int(n int) int {
    return n * 2;
}


// ============================================================================
// 5. ССЫЛКИ ПОМНЯТ ПУТЬ
// ============================================================================
//
// Главная идея Keel. Ссылка `&expr` не просто «указатель куда-то» — она
// помнит путь до объекта: `world.entities[0].hp`.
//
// Компилятор знает этот путь и может сказать, когда объект на пути
// изменился или был уничтожен. Использовать такую ссылку после этого —
// ошибка компиляции.
//
// Два правила инвалидации:
//   • значение по пути ЗАМЕНЕНО целиком → ссылка на путь и всё внутри
//     него инвалидированы;
//   • содержимое изменено (объект остался на месте) → инвалидированы
//     только ссылки строго внутри.
//
// Правило «внутрь, а не на»: если ссылка указывает на сам объект, замена
// его поля ссылку не убивает.

fn demo_paths() int {
    println("=== 5. ссылки помнят путь ===");

    let mut e = Entity(42, "goblin");

    // Ссылка на поле.
    let hp_ref = &e.hp;
    println(hp_ref);              // 42 — ссылка жива

    // Замена поля убивает ссылку на это поле:
    // e.hp = 7;                 // ошибка: ссылка hp_ref инвалидирована
    // println(hp_ref);

    // ...но ссылка на сам объект остаётся живой:
    let e_ref = &e;
    e.hp = 7;                   // замена поля
    println(e_ref.hp);            // 7 — e_ref ещё валидна

    // Ссылка на элемент массива:
    let mut w = world_of(Entity(1, "orc"), Entity(2, "rat"), Entity(3, "bat"));
    let first = &w.entities[0];
    println(first.name);          // orc

    return 0;
}


// ============================================================================
// 6. КОНТРАКТ MUT
// ============================================================================
//
// Функция, которая что-то меняет, обязана сказать что именно.
//
//   fn heal(world &World) mut(world.entities[]) { ... }
//
// Читается: «функция изменяет элементы world.entities».
//
// Это не «право писать» и не «область инвалидации» в одном лице, а
// объявление, из которого вызывающий узнаёт, какие его ссылки стали
// недействительными после вызова. Само право писать определяется
// владельцем пути: `let mut` для локальной переменной, контракт —
// для параметра.
//
// Если функция меняет путь, который не объявила, — ошибка компиляции.
// Это защищает и от забытых объявлений, и от слишком широких.

fn heal(world &World) mut(world.entities[]) {
    let a = &world.entities[0];
    let b = &world.entities[1];
    a.hp = a.hp + 10;
    b.hp = b.hp + 10;
}

fn damage(world &World, e in world.entities[] mut, amount int) {
    e.hp = e.hp - amount;
}

fn demo_contract() int {
    println("=== 6. контракт mut ===");

    let mut w = world_of(Entity(100, "orc"), Entity(80, "goblin"), Entity(50, "rat"));

    println(w.entities[0].hp);     // 100
    heal(&w);
    println(w.entities[0].hp);     // 110
    println(w.entities[1].hp);     // 90

    // Параметр-внутри: меняем элемент коллекции.
    damage(&w, &w.entities[2], 20);
    println(w.entities[2].hp);     // 30

    return 0;
}


// ============================================================================
// 7. ТО, ЧТО RUST ЗАПРЕЩАЕТ
// ============================================================================
//
// Главное обещание языка. Rust запрещает две изменяемые ссылки на одну
// коллекцию и ссылку на элемент вместе со ссылкой на контейнер — потому
// что правило «aliasable xor mutable» слишком грубое.
//
// В Keel запрещено только то, что реально опасно: использование ссылки
// после того, как объект на её пути изменился.
//
// Тот же код на Rust (examples/rust/rust_comparison.rs) не компилируется:
//     error[E0499]: cannot borrow `world.entities` as mutable more than once
//     error[E0502]: cannot borrow `world.entities` as mutable because it is
//                   also borrowed as immutable
//
// Никаких lifetime-аннотаций, никаких 'brand, никаких GhostToken.

fn two_mutable_refs(world &World) mut(world.entities[]) {
    // Rust здесь: error[E0499].
    let a = &world.entities[0];
    let b = &world.entities[1];
    a.hp = a.hp + 1;
    b.hp = b.hp + 1;
}

fn element_and_container(world &World) mut(world.entities[]) {
    // Rust здесь: error[E0502].
    let elem = &world.entities[0];
    let whole = &world.entities;
    elem.hp = elem.hp + 1;
    println(whole[1].hp);
}

fn demo_vs_rust() int {
    println("=== 7. то, что Rust запрещает ===");

    let mut w = world_of(Entity(10, "a"), Entity(20, "b"), Entity(30, "c"));
    two_mutable_refs(&w);
    println(w.entities[0].hp);     // 11
    println(w.entities[1].hp);     // 21

    element_and_container(&w);
    println(w.entities[0].hp);     // 12
    return 0;
}


// ============================================================================
// 8. УПРАВЛЕНИЕ ПОТОКОМ
// ============================================================================
//
// `if` / `else`, `while`. Условие — bool. Фигурные скобки обязательны.
//
// Цикл `for` в MVP пока нет, но пишется через `while`:
//     let mut i = 0;
//     while i < n { ...; i = i + 1; }
//
// `break` / `continue` пока не поддерживаются.
//
// Обратите внимание: у цикла нет отдельной области видимости — переменная,
// объявленная внутри тела, видна и после него. Это упрощение MVP.

fn classify(hp int) string {
    if hp > 50 {
        return "живой";
    } else {
        if hp > 0 {
            return "ранен";
        } else {
            return "мёртв";
        }
    }
}

fn sum_to(n int) int {
    let mut total = 0;
    let mut i = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn demo_control() int {
    println("=== 8. управление потоком ===");

    println(classify(100));        // живой
    println(classify(30));         // ранен
    println(classify(0));          // мёртв

    println(sum_to(10));           // 55
    return 0;
}


// ============================================================================
// 9. ЧТО KEEL ЗАПРЕЩАЕТ И КАК ЭТО РЕШАТЬ ПРАВИЛЬНО
// ============================================================================
//
// Каждый запрет разобран одинаково:
//
//     ПРОБЛЕМА   — что не так в коде;
//     ПОЧЕМУ     — что при этом опасно;
//     РЕШЕНИЕ    — как это написать в Keel.
//
// Блоки с ошибками закомментированы: они не компилируются, и рядом
// приведено точное сообщение компилятора.
//
// ---------------------------------------------------------------------------
// 9.1. Присваивание неизменяемой переменной
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     let frozen = 1;
//     frozen = 2;
//     ошибка: `frozen` не объявлен как `mut` — присваивание запрещено
//
// ПОЧЕМУ
//
// Неизменяемость по умолчанию — не про безопасность памяти, а про
// защиту от ошибок. Если `x` меняется в трёх местах функции, читать её
// становится трудно: непонятно, какое значение здесь актуально. В Keel
// `let` без `mut` означает «это значение не меняется».
//
// РЕШЕНИЕ
//
//     let mut count = 0;      // явно изменяемое
//     count = count + 1;
//
// Если переменная меняется, но вы хотите подчеркнуть, что это осознанно,
// `mut` — единственное, что нужно. Никаких дополнительных аннотаций.
//
// ---------------------------------------------------------------------------
// 9.2. Использование значения после move
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     let p = Point(1, 2);
//     let q = consume(p);     // p перемещён в consume
//     println(p.y);
//     ошибка: `p` уже перемещён, использовать нельзя
//
// ПОЧЕМУ
//
// У каждого значения один владелец. Передача аргументом перемещает
// значение: старый владелец больше не может им пользоваться, иначе
// получились бы две «владелицы» одной памяти.
//
// В C и Java это не ловится: переменная остаётся валидной, но указывает
// на объект, который кто-то уже освободил или переписал.
//
// РЕШЕНИЕ
//
// Вариант 1 — не использовать после move. Если нужно значение обратно,
// пусть функция его вернёт:
//
//     let q = consume(p);     // p больше не нужен — всё в порядке
//
// Вариант 2 — передать ссылку, если объект нужен и там, и здесь:
//
//     let p = Point(1, 2);
//     let q = peek(&p);       // peek(&Point) — не перемещает
//     println(p.y);             // p жив, ошибки нет
//
// Целоые числа, bool и string копируются — их перемещать не нужно,
// они остаются usable.
//
// ---------------------------------------------------------------------------
// 9.3. Использование ссылки после инвалидации
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     let mut e = Entity(42, "x");
//     let r = &e.hp;           // ссылка на поле hp
//     e.hp = 7;                // значение поля заменено
//     println(r);
//     ошибка: ссылка `r` инвалидирована: объект `e.hp` был изменён
//              или уничтожен
//
// ПОЧЕМУ
//
// Это главная ошибка, которую ловит Keel, и главная, которую не ловит C.
// Ссылка помнит путь до объекта (`e.hp`). Когда значение по этому пути
// заменено, ссылка указывает на старое содержимое — или, в случае
// перемещения, на освобождённую память.
//
// В Rust этот случай тоже ловится, но там ошибка возникает по другой
// причине: `&e.hp` и `e` конфликтуют как «изменяемое и разделяемое».
// В Keel достаточно, чтобы путь инвалидировался.
//
// РЕШЕНИЕ
//
// Взять свежую ссылку после изменения:
//
//     let mut e = Entity(42, "x");
//     let r = &e.hp;
//     println(r);                // 42 — ссылка ещё жива
//     e.hp = 7;
//     // r здесь уже нельзя — но и не нужно:
//     println(e.hp);             // 7 — правильно
//
// Если ссылка нужна и после изменения, меняйте содержимое, а не
// заменяйте значение: замена поля — это «replace» (убивает ссылку на
// путь и всё внутри), а изменение содержимого — «mutate inside»
// (убивает только ссылки строго внутри).
//
// ---------------------------------------------------------------------------
// 9.4. Запись в путь, не объявленный изменяемым
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     fn f(world &World) {           // нет контракта mut
//         world.entities[0].hp = 1;
//     }
//     ошибка: нельзя писать в `world.entities[0]hp`: путь не объявлен
//              изменяемым (объявлено: ничего)
//     ошибка: функция `f` изменяет `world.entities[0]hp`, но не объявляет
//              это в mut-контракте (объявлено: ничего)
//
// ПОЧЕМУ
//
// Право писать определяется владельцем пути. Для параметра-функции это
// объявленный контракт; для локальной переменной — `let mut`.
//
// РЕШЕНИЕ
//
// Объявить контракт, указав точный путь:
//
//     fn f(world &World) mut(world.entities[]) {
//         world.entities[0].hp = 1;
//     }
//
// Чем точнее контракт, тем меньше ложных запретов у вызывающих: объявление
// `mut(world.entities[])` говорит «я меняю элементы коллекции», и вызывающий
// после вызова инвалидирует свои ссылки внутрь `world.entities` — но не
// ссылку на саму коллекцию.
//
// ---------------------------------------------------------------------------
// 9.5. Функция меняет больше, чем объявила
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     fn g(world &World) mut(world.entities[]) {
//         world.alive = 0;
//     }
//     ошибка: нельзя писать в `world.alive`: путь не объявлен изменяемым
//              (объявлено: world.entities[])
//     ошибка: функция `g` изменяет `world.alive`, но не объявляет это
//              в mut-контракте (объявлено: world.entities[])
//
// ПОЧЕМУ
//
// Контракт — это не «что функция имеет право менять», а «что она
// меняет на самом деле». Если функция меняет путь, не объявленный в
// контракте, вызывающий не узнает об этом — и его слки останутся
// «живыми», хотя указывают на изменившееся. Это молчаливая ошибка.
//
// РЕШЕНИЕ
//
// Либо объявить путь, либо не менять его:
//
//     fn g(world &World) mut(world.entities[], world.alive) {
//         world.alive = 0;
//     }
//
// Проверка идёт в обе стороны: объявить лишнее тоже нельзя —
// «нельзя писать в путь, который не объявлен».
//
// ---------------------------------------------------------------------------
// 9.6. Ссылка на поле, не объявленная изменяемой
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     fn h(e &Entity) {              // `mut` не указан
//         e.hp = 0;
//     }
//     ошибка: нельзя писать в `e.hp`: путь не объявлен изменяемым
//              (объявлено: ничего)
//     ошибка: функция `h` изменяет `e.hp`, но не объявляет это
//              в mut-контракте (объявлено: ничего)
//
// ПОЧЕМУ
//
// То же, что 9.4, только для отдельного поля.
//
// РЕШЕНИЕ
//
//     fn h(e &Entity mut) {
//         e.hp = 0;
//     }
//
// Обратите внимание: `mut` здесь означает «меняется содержимое e».
// Если нужно менять сам объект (заменить его целиком), это другая
// операция и другой путь.
//
// ---------------------------------------------------------------------------
// 9.7. Неизвестное поле, функция, несовпадение типов
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     println(e.armor);         // ошибка: у структуры `Entity` нет поля
//                             // `armor`
//     nonexistent();          // ошибка: неизвестная функция `nonexistent`
//     let x int = "строка";   // ошибка: несовпадение типов: объявлено
//                             // `int`, получено `string`
//
// ПОЧЕМУ
//
// Обычная статическая проверка: опечатка в имени поля — это ошибка
// компиляции, а не «поле равно нулю в рантайме».
//
// РЕШЕНИЕ
//
// Опечатки исправляются в написании. Несовпадение типов лечится
// либо приведением, либо тем, что функция объявлена с другим типом
// параметра.
//
// ---------------------------------------------------------------------------
// 9.8. Две изменяемые ссылки на элементы одной коллекции
// ---------------------------------------------------------------------------
//
// Это НЕ запрещено — это как раз то, что Keel разрешает, а Rust нет.
//
//     let a = &world.entities[0];
//     let b = &world.entities[1];
//     a.hp = 10;              // Rust: error[E0499]
//     b.hp = 20;              // Keel: нормальный код
//
// Rust запрещает это правилом «aliasable xor mutable», которое не
// различает «две ссылки на один и тот же элемент» и «две ссылки на
// разные элементы». Keel запрещает только реальную опасность —
// использование ссылки после инвалидации.
//
// Если же ссылки указывают на ОДИН элемент и вы хотите писать через
// обе — это тоже разрешено, но функции нужен контракт mut:
//
//     fn f(world &World) mut(world.entities[]) {
//         let a = &world.entities[0];
//         let b = &world.entities[0];
//         a.hp = 10;
//         b.hp = 20;          // порядок важен, но ошибки нет
//     }
//
// (Ошибка в этом коде — не в двух ссылках, а в отсутствии контракта
// mut: без него писать нельзя вообще никому.)
//
// ---------------------------------------------------------------------------
// 9.9. Ссылка в поле структуры (ограничение v0)
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     struct Node { next &Node; }
//
//     let mut n = Node(0, 1);   // ошибка: аргумент `next`: ожидался
//                                // `&Node`, получен `int`
//
// ПОЧЕМУ
//
// Поле объявить можно — тип `&Node` в структуре допустим. Ограничение
// в другом: конструктор структуры принимает только значения, поэтому
// ссылку в поле при создании не положить.
//
// Полноценное решение — регионы: когда компилятор знает, что ссылка
// живёт не дольше структуры, её можно хранить свободно. Регионы в
// Keel пока не реализованы.
//
// РЕШЕНИЕ
//
// Сейчас — хранить индекс вместо ссылки:
//
//     struct Node { next_index int; }   // -1 = конец
//
// Индекс не требует проверки времени жизни: элемент массива живёт
// столько же, сколько сам массив.
//
// ---------------------------------------------------------------------------
// 9.10. Как объявить пустой массив
// ---------------------------------------------------------------------------
//
// ПРОБЛЕМА
//
//     let empty = [];
//     ошибка: невозможно вывести тип элемента пустого массива:
//              укажите тип явно, например `let xs [int; 0] = [];`
//
// ПОЧЕМУ
//
// У пустого массива нет элементов, а значит нет и их типа — выводить
// нечего. Тип элемента нужно назвать самому.
//
// РЕШЕНИЕ
//
// Тип объявляется явно, после имени переменной:
//
//     let empty [int; 0] = [];
//     let empty_entries [Entry; 0] = [];
//
// Длина массива в Keel задаётся в типе, поэтому пустой массив — это
// именно `[T; 0]`.
//
// То же самое для массива структур:
//
//     struct Entry { id int; name string; }
//
//     let entries [Entry; 0] = [];
//     let names [string; 0] = [];
//
// Если нужен «буфер, который потом заполним», размер всё равно надо
// задать заранее — например `[Entry; 10]`, а заполнять только первые
// несколько элементов. Динамической длины (как Vec) в MVP нет.
//
// ---------------------------------------------------------------------------
// 9.11. Что делать с ошибкой — кратко
// ---------------------------------------------------------------------------
//
//   «не объявлен как mut»          → добавьте `mut` (осознанно)
//   «уже перемещён»                 → не используйте после move или
//                                     передайте ссылку вместо владения
//   «ссылка инвалидирована»         → возьмите свежую ссылку; меняйте
//                                     содержимое, а не значение
//   «путь не объявлен изменяемым»   → добавьте контракт mut(...) точно
//                                     по этому пути
//   «изменяет, но не объявляет»     → объявите этот путь в контракте
//   «неизвестное поле/функция»      → опечатка
//   «несовпадение типов»            → исправьте тип или приведите значение
//   «невозможно вывести тип элемента
//    пустого массива»                → укажите тип явно: `let xs [int; 0] = [];`
//
// ============================================================================


// ============================================================================
// 10. СЛОВАРЬ ЯЗЫКА
// ============================================================================
//
// Ключевые слова:
//     fn          объявление функции
//     struct      объявление структуры
//     let         объявление переменной
//     mut         изменяемость: переменная, параметр или контракт путей
//     in          параметр-внутри: `e in world.entities[]`
//     return      возврат значения
//     if / else   ветвление
//     while       цикл
//     true/false  булевы литералы
//
// Типы:
//     int         64-битный целый
//     bool        логический
//     string      строка
//     void        отсутствие значения
//     T           имя структуры
//     [T; N]      массив
//     &T          ссылка (единственный вид)
//
// Операторы:
//     + - * / %      арифметика
//     == != < > <= >=  сравнения
//     && || !        логика
//     =              присваивание
//     &              взятие ссылки
//     .              доступ к полю
//     []             индексация
//
// Соглашения:
//     • Тип пишется ПОСЛЕ имени: `fuel int`, `world &World`.
//     • `&T` — единственный вид ссылки; `&mut` не существует.
//   • Тип возврата — после скобок: `fn f(x int) int`.
//   • Конструктор структуры — вызов по имени: `Point(3, 4)`.
//   • Комментарии: `//` до конца строки, `/* ... */` — блочные.
//
// Чего пока нет (MVP):
//   обобщённые типы, Vec, Option/Result, лямбды, трейты, enum,
//   модули, for/break/continue, match, асинхронность, регионы
//   (ссылку в поле структуры объявить можно, но положить туда
//   значение при создании — нет).
//
// Термины, которые стоит знать:
//   move           передача владения: старый владелец больше не может
//                  пользоваться значением
//   инвалидация    ссылка «устарела», потому что объект по её пути
//                  изменили или уничтожили
//   путь           `world.entities[0].hp` — точное место в памяти;
//                  ссылки помнят путь, а не адрес
//   контракт mut   объявление: какие пути функция меняет
//   внутри         «изменяется содержимое объекта» — инвалидирует
//                  ссылки строго внутри пути
//   замена         «объект заменён целиком» — инвалидирует ссылку
//                  на путь и всё внутри него
//
// ============================================================================

fn run_all() int {
    demo_types();
    demo_structs();
    demo_functions();
    demo_move();
    demo_paths();
    demo_contract();
    demo_vs_rust();
    demo_control();
    return 0;
}

// Точка входа. В Keel, как и в C, функция с именем `main` — это вход.
fn main() int {
    run_all();
    return 0;
}
