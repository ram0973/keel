// ============================================================================
// Keel — маленький пример
// ============================================================================
//
// Мир с четырьмя существами. Показывает главное за одну страницу:
//
//   1. Владение и перемещение значений.
//   2. Ссылки, которые помнят путь до объекта.
//   3. Параметр-внутри: `e in world.entities[]`.
//   4. Контракт `mut(...)`: что именно функция меняет.
//   5. Две изменяемые ссылки на элементы одной коллекции —
//      в Rust это запрещено (error[E0499]).
//
// Запуск:
//     cargo run -- run examples/mini.keel
//
// ============================================================================

struct Entity {
    name string;
    hp int;
}

struct World {
    entities [Entity; 4];
    alive int;
}


// --- Создание мира -----------------------------------------------------------
//
// Структуры передаются по владению: `spawn` забирает четыре `Entity`
// и возвращает собранный мир. Владение перемещается, копий нет.

fn spawn(e0 Entity, e1 Entity, e2 Entity, e3 Entity) World {
    return World([e0, e1, e2, e3], 4);
}


// --- Параметр-внутри --------------------------------------------------------
//
// `e` — это ссылка на один из элементов `world.entities`. Компилятор знает
// путь (`world.entities[]`) и потому может сказать, когда ссылка станет
// недействительной.
//
// В Rust для того же самого понадобились бы либо lifetime-аннотации,
// либо перезапрос ссылки в каждом месте.

fn damage(world &World, e in world.entities[] mut, amount int) {
    e.hp = e.hp - amount;
}


// --- Две изменяемые ссылки --------------------------------------------------
//
// `a` и `b` указывают на разные элементы одного массива, и обе живут
// одновременно. В Rust это ошибка E0499: «cannot borrow as mutable more than
// once».
//
// Здесь это безопасно: запрещено не совпадение ссылок, а использование
// ссылки после того, как объект на её пути изменился.
//
// Контракт `mut(world.entities[])` говорит: функция меняет элементы
// коллекции. Вызывающий после вызова инвалидирует свои ссылки внутрь
// `world.entities` — но не ссылку на саму коллекцию.

fn heal_two(world &World) mut(world.entities[]) {
    let a = &world.entities[0];
    let b = &world.entities[1];
    a.hp = a.hp + 10;
    b.hp = b.hp + 10;
}


// --- Сортировка -------------------------------------------------------------
//
// Тот же приём: две ссылки на соседние элементы одного массива живут
// одновременно и используются для сравнения. Ссылка помнит путь, поэтому
// после `a[j] = ...` ссылка на прежний элемент перестаёт быть валидной —
// и компилятор это знает.

fn sort_by_hp(hp &[int; 4] mut) {
    let mut i = 0;
    while i < 4 {
        let mut j = 0;
        while j < 3 {
            let x = &hp[j];        // две ссылки на один массив
            let y = &hp[j + 1];
            if x > y {             // сравнение значений, авторазыменование
                let t = hp[j];
                hp[j] = hp[j + 1];
                hp[j + 1] = t;
                // Ссылка `x` после присваивания инвалидирована:
                // объект на её пути заменён. Компилятор это знает и
                // не даст использовать `x` дальше.
            }
            j = j + 1;
        }
        i = i + 1;
    }
}


// --- Отчёт ------------------------------------------------------------------

fn report(world &World) {
    println("--- состояние ---");
    let mut i = 0;
    while i < 4 {
        println(world.entities[i].name);
        println(world.entities[i].hp);
        i = i + 1;
    }
    println("живых:");
    println(world.alive);
}


// ============================================================================

fn main() int {
    let mut world = spawn(
        Entity("orc", 30),
        Entity("goblin", 50),
        Entity("rat", 10),
        Entity("bat", 70)
    );

    report(&world);

    // Параметр-внутри: наносим урон конкретному существу.
    damage(&world, &world.entities[0], 15);

    // Две изменяемые ссылки на элементы одной коллекции.
    heal_two(&world);

    // Сортировка: две ссылки на соседние элементы одного массива
    // используются для сравнения — и перестают быть валидными после
    // перестановки. Компилятор это проверяет.
    let mut hp = [30, 50, 10, 70];
    sort_by_hp(&hp);
    println("--- hp после сортировки ---");
    println(hp[0]);
    println(hp[1]);
    println(hp[2]);
    println(hp[3]);

    report(&world);
    return 0;
}
