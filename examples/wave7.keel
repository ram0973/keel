// Что нового: len(), печать нескольких значений, const, конкатенация.
//
// Запуск:  ./target/debug/keelc run examples/wave7.keel

// ============================================================
// 1. Константы
// ============================================================
//
// Объявляются на уровне файла. Подставляются при компиляции, как
// `#define` в C: у константы нет ни адреса, ни места в памяти.
// Поэтому она годится для размера массива.

const MAX_USERS = 5;
const APP_NAME = "Keel";
const VERSION = 1 + 1;          // арифметика вычисляется при компиляции
const BIG = MAX_USERS * 2;      // константа из константы
const FLAG = true;
const GREETING = "Привет";

struct User {
    name string;
    age int;
}

fn main() int {
    println("=== 1. Константы ===");
    println(APP_NAME, " версия ", VERSION);
    println("MAX_USERS = ", MAX_USERS);
    println("BIG = ", BIG);
    println("FLAG = ", FLAG);
    println(GREETING);
    println();

    // ========================================================
    // 2. len() — длина строки и массива
    // ========================================================
    //
    // Для массива значение известно на этапе компиляции (размер — часть
    // типа). Для строки считается strlen в рантайме.

    println("=== 2. len() ===");
    let s = "hello";
    println("len(\"hello\") = ", len(s));

    let a = [10, 20, 30, 40];
    println("len([10,20,30,40]) = ", len(a));

    let users = [User("John", 26), User("Mary", 18), User("James", 18)];
    println("len(users) = ", len(users));

    // Главное: размер больше не вписывается руками. Раньше приходилось
    // писать `let count = 3;` и следить, чтобы число совпадало.
    for i in 0..len(users) {
        println("  ", i, ": ", users[i].name);
    }
    println();

    // ВНИМАНИЕ: len строки — в БАЙТАХ, а не в символах.
    // Строки в Keel — UTF-8, а strlen считает байты.
    let rus = "Привет";
    println("=== 3. len строки в байтах ===");
    println("len(\"Привет\") = ", len(rus), " (6 букв, 12 байт)");
    println();

    // ========================================================
    // 4. Печать нескольких значений
    // ========================================================
    //
    // Перевод строки — только у println, и только один раз, в конце.

    println("=== 4. Печать нескольких значений ===");
    let u = User("Leila", 30);
    println("имя: ", u.name, ", возраст: ", u.age);
    print("без перевода");
    print(" строки");
    println();
    println();
    println("=== 5. Конкатенация строк ===");

    // ========================================================
    // 5. Конкатенация строк
    // ========================================================
    //
    // `+` для двух строк даёт новую строку в куче. Её можно склеивать
    // дальше и сравнивать по содержимому.

    let msg = "Пользователь " + u.name + " возрастом " + "30 лет";
    println(msg);
    println("длина сообщения: ", len(msg), " байт");

    if msg == "Пользователь Leila возрастом 30 лет" {
        println("сравнение по содержимому работает");
    }

    // Строку с числом склеить нельзя — неявного приведения нет.
    // Это ошибка компиляции:
    //     let bad = "x = " + 5;
    println();
    println("=== Итог ===");
    println("Всё, что нужно было помнить руками, теперь считает компилятор.");

    return 0;
}
