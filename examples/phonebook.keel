// ============================================================================
// Keel — телефонная книга
// ============================================================================
//
// Прикладной пример: книга хранится в памяти, записи добавляются,
// удаляются, правятся и читаются.
//
// Главное здесь — не синтаксис, а то, что компилятор ловит устаревшие
// ссылки. В C этот код — источник тихих ошибок: взяли указатель на
// запись, запись перезаписали, а указатель продолжает указывать на
// старое содержимое.
//
// Запуск:
//     cargo run -- run examples/phonebook.keel
//
// ============================================================================

struct Entry {
    id int;
    name string;
    phone string;
}

struct Book {
    entries [Entry; 5];
    count int;
}


// --- Создание ---------------------------------------------------------------

fn new_book() Book {
    // Пять пустых мест; занятые — первые `count`.
    return Book(
        [Entry(0, "", ""), Entry(0, "", ""), Entry(0, "", ""),
         Entry(0, "", ""), Entry(0, "", "")],
        0
    );
}


// --- Добавление -------------------------------------------------------------
//
// Возвращает 1, если запись добавлена, 0 — если закончились места.
//
// Запись `book.entries[book.count] = ...` меняет содержимое коллекции.
// Все ссылки, указывающие внутрь `book.entries`, после этого становятся
// недействительными — и компилятор это проверяет.

fn add(book &Book mut, id int, name string, phone string) int {
    if book.count >= 5 {
        println("книга заполнена");
        return 0;
    }
    book.entries[book.count] = Entry(id, name, phone);
    book.count = book.count + 1;
    return 1;
}


// --- Поиск ------------------------------------------------------------------
//
// Поиск по идентификатору и по имени. Строки сравниваются по содержимому.

fn find(book &Book, id int) int {
    let mut i = 0;
    while i < book.count {
        if book.entries[i].id == id {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn find_by_name(book &Book, name string) int {
    let mut i = 0;
    while i < book.count {
        if book.entries[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


// --- Правка -----------------------------------------------------------------
//
// Запись заменяется целиком. После этого ссылка на прежнюю запись
// инвалидирована: объект по её пути был заменён.

fn edit(book &Book mut, id int, name string, phone string) int {
    let i = find(book, id);
    if i < 0 {
        println("записи нет");
        return 0;
    }
    book.entries[i] = Entry(id, name, phone);
    return 1;
}


// --- Удаление ---------------------------------------------------------------
//
// Записи сдвигаются влево, чтобы не оставлять дыр.

fn remove(book &Book mut, id int) int {
    let i = find(book, id);
    if i < 0 {
        println("записи нет");
        return 0;
    }
    // Сдвиг влево. Перенести запись целиком нельзя: move из
    // элемента коллекции запрещён (в Rust — «cannot move out of
    // index»). Поэтому копируем поля по одному — все поля Entry
    // копируемые, поэтому дыры не остаётся.
    let mut j = i;
    while j < book.count - 1 {
        book.entries[j].id = book.entries[j + 1].id;
        book.entries[j].name = book.entries[j + 1].name;
        book.entries[j].phone = book.entries[j + 1].phone;
        j = j + 1;
    }
    book.count = book.count - 1;
    return 1;
}


// --- Чтение -----------------------------------------------------------------

fn show(book &Book, id int) {
    let i = find(book, id);
    if i < 0 {
        println("записи нет");
        return;
    }
    println(book.entries[i].name);
    println(book.entries[i].phone);
}

fn show_all(book &Book) {
    println("--- книга ---");
    let mut i = 0;
    while i < book.count {
        println(book.entries[i].id);
        println(book.entries[i].name);
        println(book.entries[i].phone);
        i = i + 1;
    }
}


// ============================================================================

fn main() int {
    let mut book = new_book();

    add(&book, 1, "Иван", "+7-900-000-00-01");
    add(&book, 2, "Мария", "+7-900-000-00-02");
    add(&book, 3, "Пётр", "+7-900-000-00-03");

    show_all(&book);

    println("--- поиск по имени ---");
    let i = find_by_name(&book, "Мария");
    if i >= 0 {
        println(book.entries[i].phone);
    }

    println("--- правка ---");
    edit(&book, 2, "Мария", "+7-900-000-00-99");
    show(&book, 2);

    println("--- удаление ---");
    remove(&book, 1);
    show_all(&book);

    // -----------------------------------------------------------------------
    // ГЛАВНОЕ: компилятор ловит устаревшую ссылку.
    //
    // Мы взяли ссылку на запись, затем правка заменила запись целиком —
    // и ссылка стала недействительной. В C это тихая ошибка, в Keel —
    // ошибка компиляции.
    // -----------------------------------------------------------------------

    let first = &book.entries[0];
    println(first.name);            // 2 — Мария, ссылка ещё жива

    edit(&book, 2, "Мария", "+7-900-000-00-77");

    // println(first.phone);
    // ошибка компиляции: ссылка `first` инвалидирована: объект
    // `book.entries[0]` был изменён или уничтожен
    //
    // Правильный способ — взять свежую ссылку:
    println(book.entries[0].phone);

    return 0;
}
