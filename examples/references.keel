// Что означает & в Keel — на примерах.
//
// Главное отличие от Java: в Java объект — всегда ссылка, и параметр
// `void f(User u)` даёт функции ссылку на тот же объект. В Keel параметр
// БЕЗ `&` — это ПЕРЕМЕЩЕНИЕ: вызывающий теряет значение.
// Ссылка — только явная, через `&`.

struct Counter { n int; }

// Параметр по значению: значение перемещается в функцию.
// Изменить его здесь нельзя — он не `mut`.
fn take_by_value(c Counter) int {
    return c.n;
}

// Параметр-ссылка: функция видит объект вызывающего.
// Читать можно всегда, писать — если путь объявлен изменяемым.
fn read_by_ref(c &Counter) int {
    return c.n;
}

// Изменяемая ссылка: контракт объявляет, что функция меняет путь.
// Контракт пишется ПОСЛЕ возвращаемого типа.
fn bump_by_ref(c &Counter) int mut(c.n) {
    c.n = c.n + 100;
    return c.n;
}

fn main() int {
    // --- 1. Без &: значение перемещается ---
    let original = Counter(10);
    let r1 = take_by_value(original);
    println(r1);                      // 10
    // println(original.n);           // ошибка: `original` уже перемещён

    // --- 2. С &: вызывающий сохраняет владение ---
    let mut original = Counter(10);
    let r2 = read_by_ref(&original);
    println(r2);                      // 10
    println(original.n);              // 10 — оригинал на месте

    // --- 3. Изменяемая ссылка: функция меняет оригинал ---
    let r3 = bump_by_ref(&original);
    println(r3);                      // 110
    println(original.n);              // 110 — изменение видно вызывающему

    return 0;
}
