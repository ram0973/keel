// ============================================================================
// Keel — реестр пользователей
// ============================================================================
//
// Прикладной пример, покрывающий все конструкции языка: структуры,
// массивы, ссылки, владение, циклы, ветвление, строки.
//
// Сценарий: пять пользователей. Создать, изменить, удалить, вывести
// одного и вывести всех в цикле.
//
// Главное здесь — group borrowing. Две изменяемые ссылки на разные
// элементы коллекции живут одновременно. В Rust это ошибка E0499
// («cannot borrow as mutable more than once»). Здесь — норма: запрещено
// не совпадение ссылок, а использование ссылки после того, как объект
// на её пути изменился.
//
// Запуск:
//     cargo run -- run examples/users.keel
//
// ============================================================================

struct User {
    name string;
    age int;
}

struct Registry {
    users [User; 5];
    count int;
}


// --- Создание ---------------------------------------------------------------

fn new_registry() Registry {
    // Пять пустых мест; занятые — первые `count`.
    return Registry(
        [User("", 0), User("", 0), User("", 0), User("", 0), User("", 0)],
        0
    );
}

fn add(reg &Registry mut, name string, age int) int {
    // Возвращает 1, если пользователь добавлен, 0 — если места кончились.
    if reg.count >= 5 {
        println("реестр заполнен");
        return 0;
    }
    reg.users[reg.count] = User(name, age);
    reg.count = reg.count + 1;
    return 1;
}


// --- Поиск ------------------------------------------------------------------

fn find(reg &Registry, name string) int {
    // Индекс пользователя по имени или -1.
    let mut i = 0;
    while i < reg.count {
        if reg.users[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


// --- Изменение --------------------------------------------------------------
//
// Переименование: запись заменяется целиком. После этого ссылка на
// прежнего пользователя инвалидирована — объект на её пути был заменён.

fn rename(reg &Registry mut, name string, new_name string) int {
    let i = find(reg, name);
    if i < 0 {
        println("пользователя нет");
        return 0;
    }
    reg.users[i] = User(new_name, reg.users[i].age);
    return 1;
}

// День рождения: меняется только поле, сама запись остаётся на месте.
// Поэтому ссылка внутрь записи остаётся живой — содержимое изменилось,
// но путь не заменён.

fn birthday(reg &Registry mut, name string) int {
    let i = find(reg, name);
    if i < 0 {
        println("пользователя нет");
        return 0;
    }
    reg.users[i].age = reg.users[i].age + 1;
    return 1;
}


// --- Удаление ---------------------------------------------------------------

fn remove(reg &Registry mut, name string) int {
    // Пользователи сдвигаются влево, чтобы не оставлять дыр.
    let i = find(reg, name);
    if i < 0 {
        println("пользователя нет");
        return 0;
    }
    let mut j = i;
    while j < reg.count - 1 {
        reg.users[j] = reg.users[j + 1];
        j = j + 1;
    }
    reg.count = reg.count - 1;
    return 1;
}


// --- Вывод ------------------------------------------------------------------

fn show(reg &Registry, name string) {
    let i = find(reg, name);
    if i < 0 {
        println("пользователя нет");
        return;
    }
    print(reg.users[i].name);
    print(", ");
    println(reg.users[i].age);
}

// Вывод всех в цикле. Два способа — оба рабочие.
//
// Первый: по индексам, `for i in 0..count`. Видно поле по индексу.
// Второй: `for u in reg.users` — обход массива. Переменная цикла
// получает КОПИЮ элемента, а не ссылку: изменить через неё массив
// нельзя, но прочитать — можно.

fn show_all(reg &Registry) {
    println("--- реестр ---");
    for i in 0..reg.count {
        print(reg.users[i].name);
        print(", ");
        println(reg.users[i].age);
    }
}

fn show_all_by_value(reg &Registry) {
    println("--- реестр (обход массива) ---");
    // Обход идёт по всем пяти местам массива, а не по занятым. Пустые
    // места отсекаются проверкой. Это отличие от обхода по индексам:
    // там мы знаем точное число занятых.
    for u in reg.users {
        if u.age == 0 {
            continue;               // пустые места пропускаем
        }
        print(u.name);
        print(", ");
        println(u.age);
    }
}


// --- Считающие циклы -------------------------------------------------------

fn count_adults(reg &Registry, min_age int) int {
    // Сколько пользователей старше min_age.
    let mut n = 0;
    let mut i = 0;
    while i < reg.count {
        if reg.users[i].age >= min_age {
            n += 1;
        }
        i = i + 1;
    }
    return n;
}

fn oldest(reg &Registry) int {
    // Максимальный возраст. Цикл do-while выполняет тело хотя бы раз,
    // поэтому начальное значение не нужно.
    let mut i = 0;
    let mut max_age = 0;
    do {
        if reg.users[i].age > max_age {
            max_age = reg.users[i].age;
        }
        i = i + 1;
    } while i < reg.count;
    return max_age;
}

fn first_adult(reg &Registry, min_age int) int {
    // Первый взрослый или -1. Досрочный выход — break.
    let mut i = 0;
    while i < reg.count {
        if reg.users[i].age >= min_age {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


// ============================================================================
// Group borrowing: две изменяемые ссылки на разные элементы
// ============================================================================
//
// Это то, ради чего Keel существует. В Rust такой код не компилируется:
//
//     error[E0499]: cannot borrow `reg.users` as mutable more than once
//
// Здесь — работает, потому что запрещено не совпадение ссылок, а
// использование ссылки после изменения объекта на её пути.

fn bump_two(reg &Registry mut) {
    // Две ссылки на РАЗНЫЕ элементы одного массива. Обе живут
    // одновременно, обе изменяемые.
    let first = &reg.users[0];
    let second = &reg.users[1];

    first.age = first.age + 1;
    second.age = second.age + 1;

    println(first.name);
    println(second.name);
}

// Параметр-внутри: `u in reg.users[]` — ссылка на один элемент
// коллекции. Компилятор знает путь и инвалидирует ссылку, когда
// элемент заменяют.

fn bump_by_ref(reg &Registry, u in reg.users[] mut) {
    u.age = u.age + 10;
}


// ============================================================================

fn main() int {
    let mut reg = new_registry();

    // --- Создание: пять пользователей -------------------------------------
    add(&reg, "Иван", 30);
    add(&reg, "Мария", 25);
    add(&reg, "Пётр", 41);
    add(&reg, "Анна", 19);
    add(&reg, "Дмитрий", 35);

    show_all(&reg);

    // --- Вывод одного ------------------------------------------------------
    println("--- один пользователь ---");
    show(&reg, "Мария");

    // --- if как выражение --------------------------------------------------
    println("--- if как выражение ---");
    let n = count_adults(&reg, 30);
    let verdict = if n > 2 { "много взрослых" } else { "мало взрослых" };
    println(verdict);

    // --- Циклы --------------------------------------------------------------
    println("--- подсчёты ---");
    println(count_adults(&reg, 18));      // 5
    println(oldest(&reg));                // 41

    let i = first_adult(&reg, 30);
    if i >= 0 {
        print("первый взрослый: ");
        println(reg.users[i].name);
    }

    println("--- обход массива ---");
    show_all_by_value(&reg);

    // --- Group borrowing ----------------------------------------------------
    println("--- две изменяемые ссылки на разные элементы ---");
    bump_two(&reg);
    show(&reg, "Иван");
    show(&reg, "Мария");

    println("--- параметр-внутри ---");
    bump_by_ref(&reg, &reg.users[2]);
    show(&reg, "Пётр");

    // --- Изменение ---------------------------------------------------------
    println("--- изменение ---");
    rename(&reg, "Анна", "Анна Петровна");
    show(&reg, "Анна Петровна");

    birthday(&reg, "Мария");
    show(&reg, "Мария");

    // --- Удаление ----------------------------------------------------------
    println("--- удаление ---");
    remove(&reg, "Пётр");
    show_all(&reg);

    // -----------------------------------------------------------------------
    // ГЛАВНОЕ: компилятор ловит устаревшую ссылку.
    //
    // Мы взяли ссылку на пользователя, затем правка заменила запись
    // целиком — и ссылка стала недействительной. В C это тихая ошибка,
    // в Keel — ошибка компиляции.
    // -----------------------------------------------------------------------

    let first = &reg.users[0];
    print("до правки: ");
    println(first.name);              // Иван — ссылка ещё жива

    rename(&reg, "Иван", "Иванович");

    // println(first.age);
    // ошибка компиляции: ссылка `first` инвалидирована: объект
    // `reg.users[0]` был изменён или уничтожен
    //
    // Правильный способ — взять свежую ссылку:
    println(reg.users[0].age);

    // -----------------------------------------------------------------------
    // И наоборот: две ссылки на ОДИН элемент — тоже разрешены.
    //
    // Это важное отличие от Rust и сознательное решение: в Keel один вид
    // ссылки (`&T`), и право писать определяется владельцем пути, а не
    // видом ссылки. Поэтому запрета на совпадение ссылок нет — запрещено
    // ИСПОЛЬЗОВАНИЕ ссылки после того, как объект на её пути заменили.
    //
    //     let a = &reg.users[0];
    //     let b = &reg.users[0];   // ошибки нет
    //
    // Что Keel ловит по сравнению с C: использование ссылки на объект,
    // который уже заменён (см. выше).
    //
    // -----------------------------------------------------------------------

    return 0;
}
