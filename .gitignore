/target
*.o

# Каталоги сборки в экспериментах
experiments/*/target

# Служебные файлы с текстом сообщений коммитов. Их не должно быть
# в репозитории: git add -A иначе утащит их в коммит.
msg*.txt
COMMIT_MSG.txt
msg-fix.txt
reword.sh
seq-editor.sh

# Черновики и временные примеры пользователя.
examples/users-manual.keel
examples/_*.keel

# Песочница для экспериментов: play/ — не часть проекта, а место,
# где можно пробовать что угодно. Ни cargo, ни проверка примеров,
# ни проверка документации в неё не заходят.
play/

