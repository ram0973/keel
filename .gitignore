/target
*.o

# Каталоги сборки в экспериментах
experiments/*/target

# Служебные файлы с текстом сообщений коммитов. Их не должно быть
# в репозитории: git add -A иначе утащит их в коммит.
msg*.txt
COMMIT_MSG.txt
msg-fix.txt
commit-*.txt
reword.sh
seq-editor.sh

# Черновики и временные примеры пользователя.
examples/users-manual.keel
examples/_*.keel

# Песочница-туториал play/ — ЧАСТЬ репозитория (см. README, раздел 6).
# Раньше была git-ignored; теперь коммитится, чтобы туториал не терялся.
# Важно: ни cargo, ни проверка примеров (examples/*.keel), ни проверка
# документации (docs/*.md + README.md) в play/ не заходят — поэтому
# появление папки в репозитории ничего не ломает. Проверяется она
# отдельным блоком в scripts/check-examples.sh.

